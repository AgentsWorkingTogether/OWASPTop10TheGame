---
import { getTranslationKey, type Language } from '../utils/i18n';

export interface Props {
  translations: any;
  lang: Language;
}

const { translations, lang } = Astro.props;
---

<header class="fixed top-0 left-0 w-full bg-white/90 backdrop-blur-sm z-50 border-b-2 border-black shadow-lg">
    <div class="container mx-auto px-4 sm:px-6 py-3">
        <div class="flex justify-between items-center">
            <!-- Logo y título -->
            <div class="flex items-center">
                <a href={`/${lang}`} class="hover:text-red-700 transition-colors duration-300 cursor-pointer">
                    <h1 class="text-lg sm:text-xl md:text-2xl font-black tracking-tighter">
                        <span set:html={getTranslationKey(translations, 'header.title')}></span> 
                        <span class="text-xs sm:text-sm" set:html={getTranslationKey(translations, 'header.subtitle')}></span>
                    </h1>
                </a>
            </div>

            <!-- Navegación desktop -->
            <nav class="hidden lg:flex space-x-4 xl:space-x-8 font-bold">
                <button id="your-character-btn" class="hover:text-red-700 transition-colors duration-300 text-sm xl:text-base px-3 py-1 rounded-md bg-blue-100 hover:bg-blue-200">
                    <span set:html={getTranslationKey(translations, 'virtualTable.yourCharacter')}></span>
                </button>
                <button id="trust-indicator-btn" class="hover:text-red-700 transition-colors duration-300 text-sm xl:text-base px-3 py-1 rounded-md hover:bg-gray-100">
                    <span set:html={getTranslationKey(translations, 'virtualTable.trustIndicator')}></span>
                </button>
                <button id="system-map-btn" class="hover:text-red-700 transition-colors duration-300 text-sm xl:text-base px-3 py-1 rounded-md hover:bg-gray-100">
                    <span set:html={getTranslationKey(translations, 'virtualTable.systemMap')}></span>
                </button>
            </nav>

            <!-- Selector de idioma y botón menú móvil -->
            <div class="flex items-center space-x-4">
                <!-- Selector de idioma -->
                <div class="lang-selector">
                    <a href="/OWASPTop10TheGame/es/virtual-table" class={lang === 'es' ? 'active' : ''} data-lang="es">ES</a>
                    <a href="/OWASPTop10TheGame/en/virtual-table" class={lang === 'en' ? 'active' : ''} data-lang="en">EN</a>
                </div>

                <!-- Botón menú móvil -->
                <button id="mobile-menu-button" class="lg:hidden p-2 rounded-md hover:bg-gray-100 transition-colors duration-200">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Menú móvil -->
        <div id="mobile-menu" class="lg:hidden hidden mt-4 pb-4 border-t border-gray-200">
            <nav class="flex flex-col space-y-3 pt-4">
                <button id="your-character-btn-mobile" class="hover:text-red-700 transition-colors duration-300 font-bold text-lg px-3 py-2 rounded-md bg-blue-100 hover:bg-blue-200 text-left">
                    <span set:html={getTranslationKey(translations, 'virtualTable.yourCharacter')}></span>
                </button>
                <button id="trust-indicator-btn-mobile" class="hover:text-red-700 transition-colors duration-300 font-bold text-lg px-3 py-2 rounded-md hover:bg-gray-100 text-left">
                    <span set:html={getTranslationKey(translations, 'virtualTable.trustIndicator')}></span>
                </button>
                <button id="system-map-btn-mobile" class="hover:text-red-700 transition-colors duration-300 font-bold text-lg px-3 py-2 rounded-md hover:bg-gray-100 text-left">
                    <span set:html={getTranslationKey(translations, 'virtualTable.systemMap')}></span>
                </button>
            </nav>
        </div>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        const yourCharacterBtn = document.getElementById('your-character-btn');
        const trustIndicatorBtn = document.getElementById('trust-indicator-btn');
        const systemMapBtn = document.getElementById('system-map-btn');
        const yourCharacterBtnMobile = document.getElementById('your-character-btn-mobile');
        const trustIndicatorBtnMobile = document.getElementById('trust-indicator-btn-mobile');
        const systemMapBtnMobile = document.getElementById('system-map-btn-mobile');

        // Función para cambiar vista
        function switchToYourCharacter() {
            // Remover clases activas
            yourCharacterBtn?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            trustIndicatorBtn?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            systemMapBtn?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            yourCharacterBtnMobile?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            trustIndicatorBtnMobile?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            systemMapBtnMobile?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            
            // Agregar clases activas
            yourCharacterBtn?.classList.add('bg-blue-100', 'hover:bg-blue-200');
            yourCharacterBtnMobile?.classList.add('bg-blue-100', 'hover:bg-blue-200');
            
            // Navegar a la sección Tu Personaje
            const yourCharacterSection = document.getElementById('your-character-section');
            if (yourCharacterSection) {
                const headerHeight = 80; // Altura aproximada del header
                const elementTop = yourCharacterSection.offsetTop;
                window.scrollTo({
                    top: elementTop - headerHeight,
                    behavior: 'smooth'
                });
            }
            console.log('Navegando a Tu Personaje');
        }

        function switchToTrustIndicator() {
            // Remover clases activas
            yourCharacterBtn?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            trustIndicatorBtn?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            systemMapBtn?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            yourCharacterBtnMobile?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            trustIndicatorBtnMobile?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            systemMapBtnMobile?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            
            // Agregar clases activas
            trustIndicatorBtn?.classList.add('bg-blue-100', 'hover:bg-blue-200');
            trustIndicatorBtnMobile?.classList.add('bg-blue-100', 'hover:bg-blue-200');
            
            // Navegar a la sección Marcador de Confianza
            const trustIndicatorSection = document.getElementById('trust-indicator-section');
            if (trustIndicatorSection) {
                const headerHeight = 80; // Altura aproximada del header
                const elementTop = trustIndicatorSection.offsetTop;
                window.scrollTo({
                    top: elementTop - headerHeight,
                    behavior: 'smooth'
                });
            }
            console.log('Navegando a Marcador de Confianza');
        }

        function switchToSystemMap() {
            // Remover clases activas
            yourCharacterBtn?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            trustIndicatorBtn?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            systemMapBtn?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            yourCharacterBtnMobile?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            trustIndicatorBtnMobile?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            systemMapBtnMobile?.classList.remove('bg-blue-100', 'hover:bg-blue-200');
            
            // Agregar clases activas
            systemMapBtn?.classList.add('bg-blue-100', 'hover:bg-blue-200');
            systemMapBtnMobile?.classList.add('bg-blue-100', 'hover:bg-blue-200');
            
            // Navegar a la sección Mapa de Sistema
            const systemMapSection = document.getElementById('system-map-section');
            if (systemMapSection) {
                const headerHeight = 80; // Altura aproximada del header
                const elementTop = systemMapSection.offsetTop;
                window.scrollTo({
                    top: elementTop - headerHeight,
                    behavior: 'smooth'
                });
            }
            console.log('Navegando a Mapa de Sistema');
        }

        // Event listeners para desktop
        yourCharacterBtn?.addEventListener('click', switchToYourCharacter);
        trustIndicatorBtn?.addEventListener('click', switchToTrustIndicator);
        systemMapBtn?.addEventListener('click', switchToSystemMap);

        // Event listeners para móvil
        yourCharacterBtnMobile?.addEventListener('click', switchToYourCharacter);
        trustIndicatorBtnMobile?.addEventListener('click', switchToTrustIndicator);
        systemMapBtnMobile?.addEventListener('click', switchToSystemMap);

        // Menú móvil
        if (mobileMenuButton && mobileMenu) {
            mobileMenuButton.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Cerrar menú al hacer clic en un botón
            const mobileButtons = mobileMenu.querySelectorAll('button');
            mobileButtons.forEach(button => {
                button.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                });
            });

            // Cerrar menú al hacer scroll
            window.addEventListener('scroll', () => {
                mobileMenu.classList.add('hidden');
            });
        }

        // Inicializar con Tu Personaje activo
        switchToYourCharacter();
    });
</script> 