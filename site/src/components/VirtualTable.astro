</div>

<style>
  .card-gallery {
    aspect-ratio: 2.5/3.5;
    min-height: 200px;
    position: relative;
    overflow: hidden;
  }

  .card-gallery img {
    transition: transform 0.3s ease, opacity 0.2s ease;
  }

  .card-gallery:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 640px) {
    .card-gallery {
      min-height: 180px;
    }
  }
</style>

<script define:vars={{ characters, translations, lang }}>
  // Cargar configuración del tablero dinámicamente
  let mapConfig = null;
  let boardImage = null;
  
  // Obtener boardid del lado del cliente
  function getBoardId() {
    const urlParams = new URLSearchParams(window.location.search);
    return urlParams.get('boardid');
  }
  
  async function loadBoardConfiguration() {
    const boardid = getBoardId();
    
    console.log('🔄 Loading board configuration...');
    console.log('📋 Board ID received:', boardid);
    console.log('📋 Board ID type:', typeof boardid);
    console.log('📋 Board ID length:', boardid ? boardid.length : 0);
    console.log('📋 Current URL:', window.location.href);
    console.log('📋 Search params:', window.location.search);
    
    if (!boardid) {
      console.error('❌ Board ID is required but not provided');
      console.log('🔄 Redirecting to game page...');
      window.location.href = `/${lang}/game`;
      return;
    }
    
    try {
      console.log('🌐 Fetching boards list from GitHub...');
      // Obtener la lista de tableros disponibles
      const boardsResponse = await fetch('https://raw.githubusercontent.com/AgentsWorkingTogether/OWASPTop10TheGame/refs/heads/main/boards/list.json');
      const boardsData = await boardsResponse.json();
      
      console.log('📚 Boards list received:', boardsData);
      
      // Buscar el tablero específico por ID
      const board = boardsData.boards.find(b => b.id === boardid);
      if (!board) {
        console.error(`❌ Board with ID "${boardid}" not found in boards list`);
        console.log('📋 Available boards:', boardsData.boards.map(b => ({ id: b.id, name: b.name, path: b.path, uuid: b.uuid })));
        console.log('🔄 Redirecting to game page...');
        window.location.href = `/${lang}/game`;
        return;
      }
      
      console.log('🎯 Board found:', board);
      console.log('📍 Board path:', board.path);
      console.log('🆔 Board UUID:', board.uuid);
      
      // Construir la URL base usando path y UUID: base/PATH/UUID
      const baseUrl = `https://raw.githubusercontent.com/AgentsWorkingTogether/OWASPTop10TheGame/refs/heads/main${board.path}/${board.uuid}`;
      console.log('🔗 Base URL constructed:', baseUrl);
      
      // Construir la URL del map-config.json del tablero
      const mapConfigUrl = `${baseUrl}/map-config.json`;
      console.log('🔗 Map config URL:', mapConfigUrl);
      
      // Cargar la configuración del mapa
      console.log('📥 Loading map configuration...');
      const mapResponse = await fetch(mapConfigUrl);
      mapConfig = await mapResponse.json();
      
      console.log('📋 Map configuration loaded:', mapConfig);
      
      // Construir la URL de la imagen del tablero usando la base URL
      const imagePath = mapConfig.mapInfo.image;
      boardImage = `${baseUrl}/images/${imagePath}`;
      
      console.log('🖼️ Board image URL constructed:', boardImage);
      console.log('✅ Board configuration loaded successfully');
      
      // Actualizar la visualización del tablero
      updateBoardDisplay();
      
    } catch (error) {
      console.error('❌ Error loading board configuration:', error);
      console.error('❌ Cannot continue without board configuration');
      console.log('🔄 Redirecting to game page due to error...');
      window.location.href = `/${lang}/game`;
    }
  }
  
  function updateBoardDisplay() {
    if (!mapConfig || !boardImage) return;
    
    // Actualizar la imagen del mapa
    const mapImage = document.querySelector('#map-image');
    if (mapImage) {
      mapImage.src = boardImage;
      mapImage.alt = mapConfig.mapInfo.name || 'System Map';
    }
    
    // Actualizar los círculos de amenazas
    updateThreatCircles();
    
    // Reposicionar tokens OWASP después de actualizar el mapa
    setTimeout(() => {
      positionInitialOWASPTokens();
    }, 100);
  }
  
  function updateThreatCircles() {
    if (!mapConfig) return;
    
    // Limpiar círculos existentes
    const existingCircles = document.querySelectorAll('.threat-circle');
    existingCircles.forEach(circle => circle.remove());
    
    // Crear nuevos círculos basados en la configuración
    Object.entries(mapConfig.mapSettings).forEach(([levelKey, levelData]) => {
      Object.entries(levelData).forEach(([amenazaKey, amenazaData]) => {
        const circle = document.createElement('div');
        const radius = amenazaData.circle.radius * 2; // radius * 2 para el diámetro
        circle.className = 'threat-circle absolute rounded-full cursor-pointer hover:bg-gray-300 transition-colors duration-200 z-30';
        circle.style.width = `${radius}px`;
        circle.style.height = `${radius}px`;
        // Solo aplicar colores si el parámetro color está presente en la URL
        const urlParams = new URLSearchParams(window.location.search);
        const colorParam = urlParams.get('color');
        
        if (colorParam && amenazaData.circle.color) {
          const circleColor = amenazaData.circle.color;
          const backgroundColor = circleColor + '30'; // Agregar transparencia (30 en hex = ~0.19 de opacidad)
          const borderColor = circleColor;
          
          circle.style.backgroundColor = backgroundColor;
          circle.style.border = `2px solid ${borderColor}`;
        } else {
          // Si no hay parámetro color en la URL, mantener transparente como antes
          circle.style.backgroundColor = 'transparent';
          circle.style.border = '2px solid rgba(0, 0, 0, 0.3)';
        }
        circle.style.left = `${(amenazaData.circle.x / 1969) * 100}%`;
        circle.style.top = `${(amenazaData.circle.y / 1113) * 100}%`;
        circle.style.transform = 'translate(-50%, -50%)';
        circle.setAttribute('data-level', levelKey);
        circle.setAttribute('data-amenaza', amenazaKey);
        circle.setAttribute('data-url', amenazaData.url || '');
        
        // Agregar tooltip
        circle.title = `${levelKey} - ${amenazaKey}`;
        
        // Agregar funcionalidad de clic para abrir la URL del QR
        if (amenazaData.url) {
          circle.addEventListener('click', () => {
            window.open(amenazaData.url, '_blank');
          });
        }
        
        // Agregar al contenedor del mapa
