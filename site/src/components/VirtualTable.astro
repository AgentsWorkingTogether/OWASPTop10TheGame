    function updateUpToState() {
      let upTo = 0;
      for (let i = 0; i < blueTokensState.length; i++) {
        if (blueTokensState[i] === 0) { // Si está arriba
          upTo = i + 1;
        } else {
          break; // Si encuentra una ficha abajo, para de contar
        }
      }
      currentUpToState = upTo;
      console.log('Estado upTo actualizado:', currentUpToState);
      
      // Actualizar variable global
      if (typeof window !== 'undefined') {
        window.currentUpToState = currentUpToState;
      }
    }
    
    // Función para actualizar el estado de owasp basado en las fichas posicionadas
    function updateOwaspState() {
      const positionedTokens = [];
      const redTokens = document.querySelectorAll('[data-token-type="red"]');
      const greenTokens = document.querySelectorAll('[data-token-type="green"]');
      const threatCircles = document.querySelectorAll('.threat-circle');
      
      // Verificar qué fichas están posicionadas en círculos
      [...redTokens, ...greenTokens].forEach((token) => {
        const tokenRect = token.getBoundingClientRect();
        const tokenCenterX = tokenRect.left + tokenRect.width / 2;
        const tokenCenterY = tokenRect.top + tokenRect.height / 2;
        
        threatCircles.forEach((circle, circleIndex) => {
          const circleRect = circle.getBoundingClientRect();
          const circleCenterX = circleRect.left + circleRect.width / 2;
          const circleCenterY = circleRect.top + circleRect.height / 2;
          
          const distance = Math.sqrt(
            Math.pow(tokenCenterX - circleCenterX, 2) + 
            Math.pow(tokenCenterY - circleCenterY, 2)
          );
          
          if (distance <= circleRect.width / 2) {
            const tokenType = token.getAttribute('data-token-type') === 'red' ? 'r' : 'g';
            positionedTokens.push(`${circleIndex + 1}${tokenType}`);
          }
        });
      });
      
      currentOwaspState = positionedTokens.join(',');
      console.log('Estado owasp actualizado:', currentOwaspState);
      
      // Actualizar variable global
      if (typeof window !== 'undefined') {
        window.currentOwaspState = currentOwaspState;
      }
    }

