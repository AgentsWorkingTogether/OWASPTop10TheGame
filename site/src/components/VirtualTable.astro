  // Función para inicializar drag and drop de fichas OWASP
  function initializeOWASPTokensDragAndDrop() {
    const owaspTokens = document.querySelectorAll('[data-token-type]');
    
    owaspTokens.forEach((token, index) => {
      // Hacer las fichas arrastrables
      token.setAttribute('draggable', 'true');
      
      // Asignar un ID único a cada ficha para tracking individual
      token.dataset.tokenIndex = index;
      
      // Event listeners para drag and drop
      token.addEventListener('dragstart', handleOWASPTokenDragStart);
      token.addEventListener('dragend', handleOWASPTokenDragEnd);
      
      // Event listeners para mouse (alternativa al drag and drop)
      token.addEventListener('mousedown', handleOWASPTokenMouseDown);
    });

    // Event listeners globales para el mouse
    document.addEventListener('mousemove', handleOWASPTokenMouseMove);
    document.addEventListener('mouseup', handleOWASPTokenMouseUp);
    
    // Posicionar fichas iniciales basado en parámetro URL
    positionInitialOWASPTokens();
  }

  // Función para posicionar fichas iniciales basado en parámetro URL
  function positionInitialOWASPTokens() {
    const urlParams = new URLSearchParams(window.location.search);
    const owaspParam = urlParams.get('owasp');
    
    if (!owaspParam) return; // Si no hay parámetro, mantener posiciones por defecto
    
    // Parsear el parámetro owasp (formato: 1r,2g,3r,4g,5r,6g,7r,8g,9r,10g)
    const positions = owaspParam.split(',').map(pos => {
      const match = pos.trim().match(/^(\d+)([rg])$/);
      if (match) {
        return {
          circleIndex: parseInt(match[1]),
          tokenType: match[2] // 'r' para roja, 'g' para verde
        };
      }
      return null;
    }).filter(pos => pos !== null);
    
    // Obtener todos los círculos de amenazas (ahora son divs con clase threat-circle)
    const threatCircles = document.querySelectorAll('.threat-circle');
    
    // Obtener fichas por tipo
    const redTokens = document.querySelectorAll('[data-token-type="red"]');
    const greenTokens = document.querySelectorAll('[data-token-type="green"]');
    
    let redTokenIndex = 0;
    let greenTokenIndex = 0;
    
    positions.forEach((position, index) => {
      const circle = threatCircles[position.circleIndex - 1]; // Los índices empiezan en 1
      if (!circle) return;
      
      let token;
      if (position.tokenType === 'r' && redTokenIndex < redTokens.length) {
        token = redTokens[redTokenIndex];
        redTokenIndex++;
      } else if (position.tokenType === 'g' && greenTokenIndex < greenTokens.length) {
        token = greenTokens[greenTokenIndex];
        greenTokenIndex++;
      }
      
              if (token && circle) {
          // Centrar la ficha en el círculo
          const circleRect = circle.getBoundingClientRect();
          const circleCenterX = circleRect.left + circleRect.width / 2;
          const circleCenterY = circleRect.top + circleRect.height / 2;
          
          const finalX = circleCenterX - token.offsetWidth / 2;
          const finalY = circleCenterY - token.offsetHeight / 2;
          
          token.style.position = 'absolute';
          token.style.left = finalX + 'px';
          token.style.top = finalY + 'px';
          token.style.zIndex = '40';
          token.dataset.finalX = finalX;
          token.dataset.finalY = finalY;
          
                    console.log(`Ficha ${position.tokenType} colocada en círculo ${position.circleIndex}`);
        }
      });
      
      // Actualizar estado de owasp después del posicionamiento inicial
      updateOwaspState();
    }

  let isDragging = false;
  let currentToken = null;
  let offsetX = 0;
  let offsetY = 0;

  // Función para manejar el inicio del drag con mouse
  function handleOWASPTokenMouseDown(event) {
    const token = event.currentTarget;
    
    // Configurar el drag
    isDragging = true;
    currentToken = token;
    
    // Calcular offset del mouse respecto al elemento
    const rect = token.getBoundingClientRect();
    offsetX = event.clientX - rect.left;
    offsetY = event.clientY - rect.top;
    
            // Hacer el token flotante solo para esta ficha específica
        token.style.position = 'fixed';
        token.style.zIndex = '40';
        token.style.pointerEvents = 'none';
    
    // Efecto visual solo para esta ficha
    token.style.opacity = '0.8';
    token.style.transform = 'scale(1.1)';
    
    event.preventDefault();
    console.log('Iniciando drag de ficha OWASP con mouse - Token ID:', token.dataset.tokenIndex);
  }

  // Función para manejar el movimiento del mouse
  function handleOWASPTokenMouseMove(event) {
    if (!isDragging || !currentToken) return;
    
    // Mover el token con el mouse
    const x = event.clientX - offsetX;
    const y = event.clientY - offsetY;
    
    currentToken.style.left = x + 'px';
    currentToken.style.top = y + 'px';
  }

  // Función para manejar el fin del drag con mouse
  function handleOWASPTokenMouseUp(event) {
    if (!isDragging || !currentToken) return;
    
    // Restaurar apariencia
    currentToken.style.opacity = '1';
    currentToken.style.transform = 'scale(1)';
    currentToken.style.pointerEvents = 'auto';
    
    // Verificar si la ficha está dentro de algún círculo
    const tokenRect = currentToken.getBoundingClientRect();
    const tokenCenterX = tokenRect.left + tokenRect.width / 2;
    const tokenCenterY = tokenRect.top + tokenRect.height / 2;
    
    // Buscar todos los círculos de amenazas (ahora son divs con clase threat-circle)
    const threatCircles = document.querySelectorAll('.threat-circle');
    let closestCircle = null;
    let minDistance = Infinity;
    
    threatCircles.forEach(circle => {
      const circleRect = circle.getBoundingClientRect();
      const circleCenterX = circleRect.left + circleRect.width / 2;
      const circleCenterY = circleRect.top + circleRect.height / 2;
      
      const distance = Math.sqrt(
        Math.pow(tokenCenterX - circleCenterX, 2) + 
        Math.pow(tokenCenterY - circleCenterY, 2)
      );
      
      // Si la ficha está dentro del radio del círculo
      if (distance <= circleRect.width / 2) {
        if (distance < minDistance) {
          minDistance = distance;
          closestCircle = circle;
        }
      }
    });
    
            // Si encontró un círculo cercano, centrar la ficha
        if (closestCircle) {
          const circleRect = closestCircle.getBoundingClientRect();
          const circleCenterX = circleRect.left + circleRect.width / 2;
          const circleCenterY = circleRect.top + circleRect.height / 2;
          
          // Centrar la ficha en el círculo
          const finalX = circleCenterX - currentToken.offsetWidth / 2;
          const finalY = circleCenterY - currentToken.offsetHeight / 2;
          
          currentToken.style.position = 'absolute';
          currentToken.style.left = finalX + 'px';
          currentToken.style.top = finalY + 'px';
          currentToken.style.zIndex = '40';
          currentToken.dataset.finalX = finalX;
          currentToken.dataset.finalY = finalY;
          
          console.log('Ficha centrada en círculo de amenaza');
          
          // Actualizar estado de owasp
          updateOwaspState();
        } else {
          // Si no está en ningún círculo, mantener posición normal
          const finalX = event.clientX - offsetX;
          const finalY = event.clientY - offsetY;
          
          currentToken.style.position = 'absolute';
          currentToken.style.left = finalX + 'px';
          currentToken.style.top = finalY + 'px';
          currentToken.style.zIndex = '40';
          currentToken.dataset.finalX = finalX;
          currentToken.dataset.finalY = finalY;
          
          console.log('Finalizando drag de ficha OWASP con mouse en posición:', finalX, finalY);
          
          // Actualizar estado de owasp
          updateOwaspState();
        }
    
    // Resetear variables
    isDragging = false;
    currentToken = null;
  }

  // Función para manejar el inicio del drag (HTML5 drag and drop)
  function handleOWASPTokenDragStart(event) {
    const token = event.target;
    const tokenType = token.getAttribute('data-token-type');
    const tokenId = token.getAttribute('data-token-id');
    
    // Crear una imagen fantasma personalizada
    const ghostImage = new Image();
    ghostImage.src = token.querySelector('img').src;
    ghostImage.style.width = '48px';
    ghostImage.style.height = '48px';
    ghostImage.style.opacity = '0.8';
    event.dataTransfer.setDragImage(ghostImage, 24, 24);
    
    // Guardar datos del token
    event.dataTransfer.setData('text/plain', JSON.stringify({
      tokenType: tokenType,
      tokenId: tokenId
    }));
    
    // Efecto visual
    token.style.opacity = '0.5';
    token.style.transform = 'scale(1.1)';
    
    console.log('Iniciando drag de ficha OWASP:', tokenType, tokenId);
  }

  // Función para manejar el fin del drag (HTML5 drag and drop)
  function handleOWASPTokenDragEnd(event) {
    const token = event.target;
    
    // Restaurar apariencia
    token.style.opacity = '1';
    token.style.transform = 'scale(1)';
    
    console.log('Finalizando drag de ficha OWASP');
  }
</script>