                    style="box-shadow: 0 4px 8px rgba(0,0,0,0.3), 0 2px 4px rgba(0,0,0,0.2);"
                  />
                </div>
                <div class="cursor-move" data-token-type="green" data-token-id="3">
                  <Image 
                    src={owaspGreenImage} 
                    alt="Ficha OWASP Verde 3"
                    class="w-12 h-12 lg:w-16 lg:h-16 object-cover rounded-full border-2 border-white shadow-xl"
                    style="box-shadow: 0 4px 8px rgba(0,0,0,0.3), 0 2px 4px rgba(0,0,0,0.2);"
                  />
                </div>
                <div class="cursor-move" data-token-type="green" data-token-id="4">
                  <Image 
                    src={owaspGreenImage} 
                    alt="Ficha OWASP Verde 4"
                    class="w-12 h-12 lg:w-16 lg:h-16 object-cover rounded-full border-2 border-white shadow-xl"
                    style="box-shadow: 0 4px 8px rgba(0,0,0,0.3), 0 2px 4px rgba(0,0,0,0.2);"
                  />
                </div>
                <div class="cursor-move" data-token-type="green" data-token-id="5">
                  <Image 
                    src={owaspGreenImage} 
                    alt="Ficha OWASP Verde 5"
                    class="w-12 h-12 lg:w-16 lg:h-16 object-cover rounded-full border-2 border-white shadow-xl"
                    style="box-shadow: 0 4px 8px rgba(0,0,0,0.3), 0 2px 4px rgba(0,0,0,0.2);"
                  />
                </div>
              </div>
            </div>
          </div>
          
          <!-- Columna 2: Tu Personaje y Trust Indicator -->
          <div class="flex flex-col space-y-8">
            <!-- Fila 1: Tu Personaje -->
            <div>
              <!-- Título Tu Personaje -->
              <div class="mb-4 text-right">
                <h4 class="text-xl lg:text-2xl font-bold mb-3 text-white" set:html={getTranslationKey(translations, 'virtualTable.yourCharacter')}></h4>
                <div class="w-20 h-1 bg-red-600 ml-auto mb-3"></div>
              </div>
              
              <!-- Visor de Cartas de Personaje -->
              <div class="flex justify-end">
                <div class="bg-white p-3 lg:p-4 rounded-lg border-2 border-black shadow-lg cursor-pointer hover:scale-105 transition-transform duration-300">
                  <div class="card-gallery w-32 lg:w-40 xl:w-48">
                    <Image
                      id="character-image-desktop"
                      src={pentesterImage}
                      alt="Character"
                      class="w-full h-full object-cover rounded-md transition-opacity duration-500 transition-transform duration-300"
                    />
                  </div>
                  <p id="character-name-desktop" class="text-gray-800 text-sm lg:text-base xl:text-lg mt-3 font-bold text-center" set:html={getTranslationKey(translations, 'characters.pentester.name')}></p>
                </div>
              </div>
            </div>
            
            <!-- Fila 2: Trust Indicator -->
            <div>
              <!-- Título Marcador de Confianza -->
              <div id="trust-indicator-section" class="mb-4 text-right">
                <h4 class="text-xl lg:text-2xl font-bold mb-3 text-white" set:html={getTranslationKey(translations, 'virtualTable.trustIndicator')}></h4>
                <div class="w-20 h-1 bg-red-600 ml-auto mb-3"></div>
              </div>
              
              <!-- Trust Indicator -->
              <div class="flex justify-end">
                <div class="relative">
                  <Image 
                    src={trustIndicatorImage} 
                    alt="Trust Indicator"
                    class="w-64 lg:w-72 xl:w-80 h-auto"
                  />
                  <!-- Fichas azules con posicionamiento absoluto -->
                                                          <div id="blue-token-1-desktop" class="absolute" style="bottom: 65px; left: 10.5%;">
                      <Image src={teamBlueImage} alt="Ficha Team Blue 1" class="w-8 h-8 lg:w-9 lg:h-9 xl:w-11 xl:h-11 object-cover rounded-full border-2 border-white shadow-sm cursor-move draggable bg-white" style="box-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 1px 1px rgba(0,0,0,0.2);" />
                    </div>
                    <div id="blue-token-2-desktop" class="absolute" style="bottom: 55px; left: 27%">
                      <Image src={teamBlueImage} alt="Ficha Team Blue 2" class="w-8 h-8 lg:w-9 lg:h-9 xl:w-11 xl:h-11 object-cover rounded-full border-2 border-white shadow-sm cursor-move draggable bg-white" style="box-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 1px 1px rgba(0,0,0,0.2);" />
                    </div>
                    <div id="blue-token-3-desktop" class="absolute" style="bottom: 55px; left: 43.5%;">
                      <Image src={teamBlueImage} alt="Ficha Team Blue 3" class="w-8 h-8 lg:w-9 lg:h-9 xl:w-11 xl:h-11 object-cover rounded-full border-2 border-white shadow-sm cursor-move draggable bg-white" style="box-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 1px 1px rgba(0,0,0,0.2);" />
                    </div>
                    <div id="blue-token-4-desktop" class="absolute" style="bottom: 55px; left: 60.3%;">
                      <Image src={teamBlueImage} alt="Ficha Team Blue 4" class="w-8 h-8 lg:w-9 lg:h-9 xl:w-11 xl:h-11 object-cover rounded-full border-2 border-white shadow-sm cursor-move draggable bg-white" style="box-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 1px 1px rgba(0,0,0,0.2);" />
                    </div>
                    <div id="blue-token-5-desktop" class="absolute" style="bottom: 55px; left: 77%;">
                      <Image src={teamBlueImage} alt="Ficha Team Blue 5" class="w-8 h-8 lg:w-9 lg:h-9 xl:w-11 xl:h-11 object-cover rounded-full border-2 border-white shadow-sm cursor-move draggable bg-white" style="box-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 1px 1px rgba(0,0,0,0.2);" />
