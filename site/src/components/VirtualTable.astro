        </div>
        <div id="blue-token-5" class="absolute" style="bottom: 68px; left: 76.5%;">
          <Image src={teamBlueImage} alt="Ficha Team Blue 5" class="w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 object-cover rounded-full border-2 border-white shadow-xl cursor-move draggable bg-white" style="box-shadow: 0 4px 8px rgba(0,0,0,0.3), 0 2px 4px rgba(0,0,0,0.2);" />
        </div>
      </div>
      
      <!-- Título Mapa de Sistema -->
      <div id="system-map-section" class="mb-6 text-center mt-10">
        <h4 class="text-xl sm:text-2xl font-bold mb-3 sm:mb-4 text-white" set:html={getTranslationKey(translations, 'virtualTable.systemMap')}></h4>
        <div class="w-16 sm:w-24 h-1 bg-red-600 mx-auto mb-3 sm:mb-4"></div>
      </div>
      
      <!-- System Map Placeholder -->
