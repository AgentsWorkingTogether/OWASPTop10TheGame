---
import LanguageSelector from './LanguageSelector.astro';
import { getTranslationKey, type Language } from '../utils/i18n';

export interface Props {
  translations: any;
  lang: Language;
}

const { translations, lang } = Astro.props;
---

<header class="fixed top-0 left-0 w-full bg-white/90 backdrop-blur-sm z-50 border-b-2 border-black shadow-lg">
    <div class="container mx-auto px-4 sm:px-6 py-3">
        <div class="flex justify-between items-center">
            <!-- Logo y título -->
            <div class="flex items-center">
                <a href="#home" class="hover:text-red-700 transition-colors duration-300 cursor-pointer">
                    <h1 class="text-lg sm:text-xl md:text-2xl font-black tracking-tighter">
                        <span set:html={getTranslationKey(translations, 'header.title')}></span> 
                        <span class="text-xs sm:text-sm" set:html={getTranslationKey(translations, 'header.subtitle')}></span>
                    </h1>
                </a>
            </div>

            <!-- Navegación desktop -->
            <nav class="hidden lg:flex space-x-4 xl:space-x-8 font-bold">
                <a href="#about" class="hover:text-red-700 transition-colors duration-300 text-sm xl:text-base" set:html={getTranslationKey(translations, 'nav.game')}></a>
                <a href="#characters" class="hover:text-red-700 transition-colors duration-300 text-sm xl:text-base" set:html={getTranslationKey(translations, 'nav.characters')}></a>
                <a href="#components" class="hover:text-red-700 transition-colors duration-300 text-sm xl:text-base" set:html={getTranslationKey(translations, 'nav.components')}></a>
                <a href="#how-to-play" class="hover:text-red-700 transition-colors duration-300 text-sm xl:text-base" set:html={getTranslationKey(translations, 'nav.rules')}></a>
                <a href="#team-building" class="hover:text-red-700 transition-colors duration-300 text-sm xl:text-base" set:html={getTranslationKey(translations, 'nav.team_building')}></a>
            </nav>

            <!-- Selector de idioma, botón compartir y menú móvil -->
            <div class="flex items-center space-x-4">
                <LanguageSelector lang={lang} />
                
                <!-- Botón compartir -->
                <button id="share-button" class="p-2 rounded-md hover:bg-gray-100 transition-colors duration-200" title="Compartir">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
                    </svg>
                </button>
                
                <!-- Botón menú móvil -->
                <button id="mobile-menu-button" class="lg:hidden p-2 rounded-md hover:bg-gray-100 transition-colors duration-200">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Menú móvil -->
        <div id="mobile-menu" class="lg:hidden hidden mt-4 pb-4 border-t border-gray-200">
            <nav class="flex flex-col space-y-3 pt-4">
                <a href="#about" class="hover:text-red-700 transition-colors duration-300 font-bold text-lg" set:html={getTranslationKey(translations, 'nav.game')}></a>
                <a href="#characters" class="hover:text-red-700 transition-colors duration-300 font-bold text-lg" set:html={getTranslationKey(translations, 'nav.characters')}></a>
                <a href="#components" class="hover:text-red-700 transition-colors duration-300 font-bold text-lg" set:html={getTranslationKey(translations, 'nav.components')}></a>
                <a href="#how-to-play" class="hover:text-red-700 transition-colors duration-300 font-bold text-lg" set:html={getTranslationKey(translations, 'nav.rules')}></a>
                <a href="#team-building" class="hover:text-red-700 transition-colors duration-300 font-bold text-lg" set:html={getTranslationKey(translations, 'nav.team_building')}></a>
            </nav>
        </div>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        const shareButton = document.getElementById('share-button');

        if (mobileMenuButton && mobileMenu) {
            mobileMenuButton.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Cerrar menú al hacer clic en un enlace
            const mobileLinks = mobileMenu.querySelectorAll('a');
            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                });
            });

            // Cerrar menú al hacer scroll
            window.addEventListener('scroll', () => {
                mobileMenu.classList.add('hidden');
            });
        }

        // Funcionalidad del botón compartir
        if (shareButton) {
            shareButton.addEventListener('click', () => {
                // Obtener el estado actual de upTo y owasp desde las variables globales
                const currentUpTo = window.currentUpToState || 0;
                const currentOwasp = window.currentOwaspState || '';
                
                // Construir la URL base
                const baseUrl = window.location.origin + window.location.pathname;
                const params = new URLSearchParams();
                
                // Agregar parámetros si existen
                if (currentUpTo > 0) {
                    params.set('upto', currentUpTo.toString());
                }
                if (currentOwasp) {
                    params.set('owasp', currentOwasp);
                }
                
                // Construir la URL final
                const shareUrl = params.toString() ? `${baseUrl}?${params.toString()}` : baseUrl;
                
                console.log('URL generada para compartir:', shareUrl);
                console.log('Estado actual - upTo:', currentUpTo, 'owasp:', currentOwasp);
                
                // Intentar usar la Web Share API si está disponible
                if (navigator.share) {
                    navigator.share({
                        title: 'OWASP Top 10 The Game',
                        url: shareUrl
                    }).catch(console.error);
                } else {
                    // Fallback: copiar al portapapeles
                    navigator.clipboard.writeText(shareUrl).then(() => {
                        // Mostrar feedback visual
                        const originalTitle = shareButton.getAttribute('title');
                        if (originalTitle) {
                            shareButton.setAttribute('title', '¡URL copiada!');
                            shareButton.classList.add('bg-green-100');
                            
                            setTimeout(() => {
                                shareButton.setAttribute('title', originalTitle);
                                shareButton.classList.remove('bg-green-100');
                            }, 2000);
                        }
                    }).catch(console.error);
                }
            });
        }
    });
</script> 