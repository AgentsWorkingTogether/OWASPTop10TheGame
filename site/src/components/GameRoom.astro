    generatePlayerURL(playerId: string, playerName: string, urlButton: HTMLButtonElement) {
      console.log('Generating URL for player:', playerName);
      
      // Generate unique peer ID for this URL generation
      const peerId = 'peer_' + playerId + '_' + Date.now();
      console.log('Generated URL peerId:', peerId);
      
      // Store the peerId to capture its specific offer data
      const targetPeerId = peerId;
      
      // First initiate connection to get the offer using the specific peerId
      this.connectToPlayerWithPeerId(playerId, playerName, targetPeerId);
      
      // Wait for the specific offer to be generated for this peerId
      const checkOfferReady = () => {
        // Check if this specific peer's offer is ready in pendingOffers
        const pendingOffer = this.pendingOffers.get(targetPeerId);
        const iceCandidates = this.iceCandidates.get(targetPeerId);
        const iceComplete = this.iceGatheringComplete.get(targetPeerId);
        
        if (pendingOffer && iceComplete) {
          console.log('Offer ready for peerId:', targetPeerId);
          
          // Create the offer data for this specific peer
          const offerData = {
            offer: pendingOffer,
            iceCandidates: iceCandidates || [],
            peerId: targetPeerId
          };
          
          const gameId = this.gameCode;
          if (gameId) {
            // Encode offer data to base64
            const encodedData = btoa(JSON.stringify(offerData));
            
            // Get current URL without query parameters
            const baseUrl = window.location.origin + window.location.pathname;
            
            // Generate the URL with parameters
            let gameUrl = `${baseUrl}?gameId=${gameId}&data=${encodedData}`;
            
            // Add phone number as query parameter if available
            if (this.playerPhone) {
              gameUrl += `&phone=${encodeURIComponent(this.playerPhone)}`;
            }
            
            // Copy URL to clipboard
            navigator.clipboard.writeText(gameUrl).then(() => {
              console.log(`URL copiada al portapapeles para ${playerName} (${targetPeerId})`);
              
              // Change button text temporarily
              urlButton.textContent = '¡Copiado!';
              
              // Reset button text after 2 seconds
              setTimeout(() => {
                urlButton.textContent = 'URL';
              }, 2000);
              
            }).catch(err => {
              console.error('Error copying URL:', err);
              // Fallback: show URL in a prompt
              prompt(`URL para ${playerName} (copia manualmente):`, gameUrl);
            });
          }
        } else {
          // Retry after a short delay
          setTimeout(checkOfferReady, 100);
        }
      };
      
      // Start checking for offer availability
      setTimeout(checkOfferReady, 100);
    }

    generatePlayerQR(playerId: string, playerName: string, qrButton: HTMLButtonElement) {
      console.log('Generating QR for player:', playerName);
      const peerId = 'peer_' + playerId + '_' + Date.now();
      const targetPeerId = peerId;
      this.connectToPlayerWithPeerId(playerId, playerName, targetPeerId);

      const checkOfferReady = () => {
        const pendingOffer = this.pendingOffers.get(targetPeerId);
        const iceCandidates = this.iceCandidates.get(targetPeerId);
        const iceComplete = this.iceGatheringComplete.get(targetPeerId);
        
        if (pendingOffer && iceComplete) {
          const offerData = {
            offer: pendingOffer,
            iceCandidates: iceCandidates || [],
            peerId: targetPeerId
          };
          const gameId = this.gameCode;
          if (gameId) {
            const encodedData = btoa(JSON.stringify(offerData));
            const baseUrl = window.location.origin + window.location.pathname;
            let gameUrl = `${baseUrl}?gameId=${gameId}&data=${encodedData}`;
            
            // Add phone number as query parameter if available
            if (this.playerPhone) {
              gameUrl += `&phone=${encodeURIComponent(this.playerPhone)}`;
            }
            
            this.openQRModal(gameUrl);
            qrButton.textContent = 'QR';
          }
        } else {
          setTimeout(checkOfferReady, 100);
        }
      };
      setTimeout(checkOfferReady, 100);
    }

