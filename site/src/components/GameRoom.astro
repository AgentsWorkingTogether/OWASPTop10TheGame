    async createGame() {
      this.isCreator = true;
      this.gameCode = this.generateGameCode();
      this.peerConnections = new Map(); // Initialize peer connections
      this.dataChannels = new Map(); // Initialize data channels
      this.iceCandidates = new Map(); // Reset ICE candidates
      this.iceGatheringComplete = new Map(); // Reset gathering status
      this.pendingOffers = new Map(); // Reset pending offers
      
      // Show map selection first
      this.gameSetup?.classList.add('hidden');
      this.mapSelection?.classList.remove('hidden');
      
      // Load available maps
      this.loadMaps();
    }



    async processPastedData() {
      try {
        const pastedData = this.pasteTextarea?.value.trim();
        if (!pastedData) {
          alert('Por favor pega la información del otro jugador');
          return;
        }

        const data = JSON.parse(pastedData);
        console.log('Processing pasted data for peer:', data.peerId);
        
        if (this.isCreator) {
          // Creator processes the answer - MUST have peerId in the response
          if (!data.peerId) {
            throw new Error('La respuesta no contiene identificación de peer. Asegúrate de usar la URL generada más reciente.');
          }
          
          const targetPeerId = data.peerId;
          const peerConnection = this.peerConnections.get(targetPeerId);
          
          if (!peerConnection) {
            console.error('Available peers:', Array.from(this.peerConnections.keys()));
            throw new Error(`No se encontró conexión para el peer: ${targetPeerId}. Verifica que la respuesta corresponda a una oferta válida.`);
          }

          if (data.answer) {
            // This is an answer from the player with ICE candidates
            await peerConnection.setRemoteDescription(data.answer);
            // Add ICE candidates
            if (data.iceCandidates) {
              for (const candidate of data.iceCandidates) {
                await peerConnection.addIceCandidate(candidate);
              }
            }
          } else if (data.type === 'answer') {
            // This is a simple answer (backward compatibility)
            await peerConnection.setRemoteDescription(data);
          } else {
            throw new Error('Invalid data format for creator');
          }
          
          // Clear both textareas after successful processing
          if (this.copyTextarea) this.copyTextarea.value = '';
          if (this.pasteTextarea) this.pasteTextarea.value = '';
          
          this.updateStatus('connected', `Conectado con ${targetPeerId}`);
          this.showNextStep(`¡Conexión completada con el jugador! Puedes generar más ofertas para otros jugadores.`);
          this.hidePasteInstruction();
          this.showGameRoom();
        } else {
          // Player processes the offer and creates answer
          const peerConnection = this.peerConnections.get('player_connection');
          if (!peerConnection) {
            throw new Error('No peer connection available for player');
          }

          // Store peerId from the offer to include in the answer
          if (data.peerId) {
            this.receivedPeerId = data.peerId;
            console.log('Player: Received offer from peer:', data.peerId);
          }

          if (data.offer) {
            // This is an offer from the creator with ICE candidates
            await peerConnection.setRemoteDescription(data.offer);
            // Add ICE candidates
            if (data.iceCandidates) {
              for (const candidate of data.iceCandidates) {
                await peerConnection.addIceCandidate(candidate);
              }
            }
          } else if (data.type === 'offer') {
            // This is a simple offer (backward compatibility)
            await peerConnection.setRemoteDescription(data);
          } else {
            throw new Error('Invalid data format for player');
          }
          
          const answer = await peerConnection.createAnswer();
          await peerConnection.setLocalDescription(answer);
          
          // Store answer for later display when ICE gathering is complete
          this.pendingOffers.set('player_connection', answer);
          this.updateStatus('waiting', 'Generando ICE candidates...');
          this.showNextStep('Esperando a que se generen todos los ICE candidates...');
        }
      } catch (error) {
        console.error('Error processing data:', error);
        const errorMessage = error instanceof Error ? error.message : 'Error desconocido';
        alert('Error procesando la información: ' + errorMessage);
      }
    }

    async initializeWebRTC() {
      // Clean up any existing connection
      this.cleanup();
      
      const configuration = {
        iceServers: [
          { urls: 'stun:stun.l.google.com:19302' },
          { urls: 'stun:stun1.l.google.com:19302' }
        ]
      };

      if (this.isCreator) {
        // For creator, we'll handle multiple peers in generateNewOffer
        console.log('Creator: WebRTC will be initialized per peer connection');
      } else {
        // For players, simple single connection
        const peerId = 'player_connection';
        const peerConnection = new RTCPeerConnection(configuration);
        
        // Initialize Maps if they don't exist
        if (!this.peerConnections) {
          this.peerConnections = new Map();
        }
        if (!this.dataChannels) {
          this.dataChannels = new Map();
        }
        if (!this.iceCandidates) {
          this.iceCandidates = new Map();
        }
        if (!this.iceGatheringComplete) {
          this.iceGatheringComplete = new Map();
        }
        if (!this.pendingOffers) {
          this.pendingOffers = new Map();
        }
        
        // Store the peer connection
        this.peerConnections.set(peerId, peerConnection);
        this.isInitialized = true;

        // Set up data channel for player
        peerConnection.ondatachannel = (event) => {
          const dataChannel = event.channel;
          this.dataChannels.set(peerId, dataChannel);
          this.setupDataChannel(dataChannel, peerId);
        };

        // Handle ICE candidates for player
        peerConnection.onicecandidate = (event) => {
          if (event.candidate) {
            console.log('New ICE candidate for player:', event.candidate);
            if (!this.iceCandidates.has(peerId)) {
              this.iceCandidates.set(peerId, []);
            }
            const candidates = this.iceCandidates.get(peerId);
            if (candidates) {
              candidates.push(event.candidate);
            }
          } else {
            console.log('ICE gathering complete for player');
            this.onIceGatheringComplete(peerId);
          }
        };

        // Handle connection state changes for player
        peerConnection.onconnectionstatechange = () => {
          console.log('Connection state for player:', peerConnection.connectionState);
          if (peerConnection.connectionState === 'connected') {
            this.updateStatus('connected', 'Conectado');
            this.showGameRoom();
          }
        };
      }
    }

    setupDataChannel(channel: RTCDataChannel, peerId?: string) {
      channel.onopen = () => {
        console.log('Data channel opened for peer:', peerId);
        if (this.connectedPlayers) {
          this.connectedPlayers.textContent = (this.players.size + 1).toString();
        }
        // Connection established
        console.log('Data channel opened - connection established');
        
        if (this.isCreator && peerId) {
          // Creator assigns name to the new player
          console.log('Looking for player name for peerId:', peerId);
          console.log('Registered players:', this.registeredPlayers);
          const playerName = this.getPlayerNameForPeer(peerId);
          console.log('Found player name:', playerName);
          if (playerName) {
            // Add to local players list (for peer management)
            this.players.set(peerId, playerName);
            
            // Add to the main players array immediately
            if (!this.allPlayersNames.includes(playerName)) {
              console.log('Adding player to main list immediately:', playerName);
              this.allPlayersNames.push(playerName);
            }
            
            // Send assigned name to the new player first
            const assignNameMessage = {
              type: 'assign_player_name',
              name: playerName,
              peerId: peerId
            };
            channel.send(JSON.stringify(assignNameMessage));
            
            // Send updated players list to everyone immediately
            this.sendPlayersUpdateToAll();
            
            // Update start game button state
            this.updateStartGameButtonState();
            
            // Send current leader information to the new player
            if (this.leaderName) {
              const leaderMessage = {
                type: 'game_variable',
                variable: 'leader',
                value: this.leaderName
              };
              channel.send(JSON.stringify(leaderMessage));
            }
            
            // Send game code to the new player
            if (this.gameCode) {
              const gameCodeMessage = {
                type: 'game_variable',
                variable: 'game_code',
                value: this.gameCode
              };
              channel.send(JSON.stringify(gameCodeMessage));
              console.log(`📤 Enviando código de partida ${this.gameCode} a ${playerName}`);
            }
          } else {
            console.log('WARNING: No player name found for peerId:', peerId);
            console.log('This might be a generic connection or URL-based connection');
            
            // Generate a generic name for this player
            const genericPlayerName = `Jugador ${this.players.size + 1}`;
            console.log('Assigning generic name:', genericPlayerName);
            
            // Add to local players list (for peer management)
            this.players.set(peerId, genericPlayerName);
            
            // Add to the main players array immediately
            if (!this.allPlayersNames.includes(genericPlayerName)) {
              console.log('Adding generic player to main list immediately:', genericPlayerName);
              this.allPlayersNames.push(genericPlayerName);
            }
            
            // Send assigned name to the new player first
            const assignNameMessage = {
              type: 'assign_player_name',
              name: genericPlayerName,
              peerId: peerId
            };
            channel.send(JSON.stringify(assignNameMessage));
            
            // Send updated players list to everyone immediately
            this.sendPlayersUpdateToAll();
            
            // Update start game button state
            this.updatePlayersList();
            
            // Send current leader information to the new player
            if (this.leaderName) {
              const leaderMessage = {
                type: 'game_variable',
                variable: 'leader',
                value: this.leaderName
              };
              channel.send(JSON.stringify(leaderMessage));
            }
            
            // Send game code to the new player
            if (this.gameCode) {
              const gameCodeMessage = {
                type: 'game_variable',
                variable: 'game_code',
                value: this.gameCode
              };
              channel.send(JSON.stringify(gameCodeMessage));
              console.log(`📤 Enviando código de partida ${this.gameCode} a ${genericPlayerName}`);
            }
          }
        } else {
          // Player sends their name to creator
          if (this.playerName) {
            const nameMessage = {
              type: 'player_name',
              name: this.playerName,
              senderId: peerId || 'unknown'
            };
            channel.send(JSON.stringify(nameMessage));
          }
        }
      };

      channel.onclose = () => {
        console.log('Data channel closed for peer:', peerId);
        
        // Only cleanup if this is a critical connection loss
        if (this.isCreator && this.dataChannels.size <= 1) {
          console.log('Critical connection loss - cleaning up');
          this.cleanup();
        } else if (!this.isCreator) {
          // For players, always cleanup on channel close
          console.log('Player connection lost - cleaning up');
          this.cleanup();
        } else {
          // For creator with multiple peers, just remove this specific channel
          if (peerId) {
            console.log('Removing specific peer channel:', peerId);
            this.dataChannels.delete(peerId);
            this.peerConnections.delete(peerId);
          }
          
          // Update connected players count
          if (this.connectedPlayers) {
            this.connectedPlayers.textContent = Math.max(0, this.dataChannels.size).toString();
          }
        }
      };

      channel.onerror = (error) => {
        console.error('Data channel error for peer:', peerId, error);
        
        // Don't immediately cleanup on error - let onclose handle it
        console.log('Data channel error - will handle in onclose event');
      };

      channel.onmessage = (event: MessageEvent) => {
        console.log('Received message from peer:', peerId, event.data);
        this.messagesReceived++;
        
        // Handle different message types
        try {
          const message = JSON.parse(event.data);
          if (message.type === 'player_name') {
            // Handle player name message - only store, don't respond to avoid loops
            console.log('Received player name:', message.name, 'from peer:', peerId);
            // Store the player name with peer ID
            if (peerId && message.name) {
              this.players.set(peerId, message.name);
              this.updatePlayersList();
            }
          } else if (message.type === 'assign_player_name') {
            // Player receives their assigned name from creator
            console.log('Received assigned name:', message.name, 'for peer:', message.peerId);
            this.playerName = message.name;
            
            // Update current player name display
            if (this.currentPlayerName) {
              this.currentPlayerName.textContent = this.playerName;
            }
            
            // Also update the players list to reflect the current player's name
            this.updatePlayersList();
          } else if (message.type === 'players_update') {
            // All players receive updated complete list of player names
            console.log('Received players update:', message.playerNames);
            this.processPlayersUpdate(message.playerNames);
            
            // Also update the display immediately
            this.updatePlayersList();
          } else if (message.type === 'game_variable') {
            // Handle game variable updates
            console.log('Received game variable update:', message.variable, message.value);
            // Update local game variables based on the message
            if (message.variable === 'upto') {
              this.uptoValue = message.value;
              this.updateUptoDisplay();
            } else if (message.variable === 'mapa') {
              this.mapaValue = message.value;
              this.updateMapaDisplay();
              this.updateStartGameButtonState();
            } else if (message.variable === 'owasp') {
              this.owaspValue = message.value;
              this.updateOwaspDisplay();
            } else if (message.variable === 'game_code') {
              // Player receives the game code
              console.log('Received game code:', message.value);
              this.gameCode = message.value;
              // Update the game code display
              if (this.gameCodeDisplay) {
                this.gameCodeDisplay.textContent = this.gameCode;
              }
            } else if (message.variable === 'leader') {
              // Standard leader update (from sendGameVariableUpdate)
              this.leaderName = message.value;
              
              // Check if current player is the new leader
              if (message.value === this.playerName) {
                this.isLeader = true;
              } else {
                this.isLeader = false;
              }
              
              // Update UI
              this.updateLeaderDisplay();
              this.updateUptoDisplay();
              this.updateOwaspDisplay();
              this.updatePlayersList();
            } else if (message.variable === 'player_character') {
              // Player receives their assigned character
              console.log('Personaje asignado:', message.value);
              this.updatePlayerCharacterDisplay(message.value);
            } else if (message.variable === 'character_distribution') {
              // Player receives character distribution information
              console.log('📊 Distribución de personajes recibida:', message.value);
              this.updateCharacterCounts(message.value.goodCharacters, message.value.badCharacters);
            } else if (message.variable === 'reveal_bad_players') {
              // Player receives reveal bad players message
              console.log('🕵️ Mensaje de revelación de jugadores malos recibido');
              this.handleBadPlayersReveal(message.value.badPlayers);
            } else if (message.variable === 'hide_bad_players') {
              // Player receives hide bad players message
              console.log('🕵️ Mensaje para ocultar jugadores malos recibido');
              this.handleBadPlayersHide();

            } else if (message.variable === 'player_number') {
              // Player receives their assigned number
              console.log('Número asignado:', message.value);
              this.updatePlayerNumberDisplay(message.value);
            } else if (message.variable === 'leadership_change') {
              // Handle leadership change
              console.log('Cambio de liderazgo recibido:', message.value);
              this.handleLeadershipChange(message.value.newLeader, message.value.previousLeader);
            } else if (message.variable === 'game_started') {
              // Handle game started notification
              console.log('Partida iniciada recibida:', message.value);
              this.gameStarted = message.value;
              console.log(`Estado de partida actualizado: gameStarted=${this.gameStarted}`);
              
              // Update UI elements that depend on game state
              this.updatePlayersList();
            }
            
            // If creator, broadcast to other players (except sender)
            if (this.isCreator && peerId) {
              this.broadcastToOthers(message, peerId);
            }
          } else {
            // Handle other message types
            console.log('Received message:', message);
          }
        } catch (error) {
          // Handle plain text messages (backward compatibility)
          console.log('Received plain text:', event.data);
        }
      };
    }

    generateGameCode() {
      return Math.random().toString(36).substring(2, 8).toUpperCase();
    }

    updateStatus(state: string, message: string) {
      const indicator = this.statusIndicator?.querySelector('div');
      const text = this.statusText;
      
      if (indicator) {
        indicator.className = 'w-3 h-3 rounded-full';
        
        switch (state) {
          case 'waiting':
            indicator.classList.add('bg-yellow-500');
            break;
          case 'connected':
            indicator.classList.add('bg-green-500');
            break;
          default:
            indicator.classList.add('bg-red-500');
        }
      }
      
      if (text) {
        text.textContent = message;
      }
    }

    showNextStep(message: string) {
      if (this.nextStepInfo && this.nextStepText) {
        this.nextStepText.textContent = message;
        this.nextStepInfo.classList.remove('hidden');
      }
    }

    showPasteInstruction() {
      if (this.pasteInstruction) {
        this.pasteInstruction.classList.remove('hidden');
      }
    }

    hidePasteInstruction() {
      if (this.pasteInstruction) {
        this.pasteInstruction.classList.add('hidden');
      }
    }

    onIceGatheringComplete(peerId: string) {
      if (!this.iceGatheringComplete || !this.pendingOffers || !this.iceCandidates) {
        console.error('Maps not initialized');
        return;
      }

      this.iceGatheringComplete.set(peerId, true);
      const candidates = this.iceCandidates.get(peerId) || [];
      const pendingOffer = this.pendingOffers.get(peerId);
      
      console.log('ICE gathering complete for peer', peerId, 'candidates:', candidates.length);
      
      if (pendingOffer && this.copyTextarea) {
        if (this.isCreator) {
          // Creator generated an offer
          console.log('Creating offer with peerId:', peerId);
          const offerData = {
            offer: pendingOffer,
            iceCandidates: candidates,
            peerId: peerId  // Include peerId for identification
          };
          this.copyTextarea.value = JSON.stringify(offerData);
          this.updateStatus('waiting', 'Oferta generada');
          this.showNextStep('Copia la oferta y compártela con el jugador. Luego pega la respuesta para completar la conexión.');
          this.showPasteInstruction();
          
          // Show WhatsApp button if phone number is available
          if (this.playerPhone && this.whatsappBtn) {
            this.whatsappBtn.classList.remove('hidden');
          }
          // Show Telegram button if phone number is available
          if (this.playerPhone && this.telegramBtn) {
            this.telegramBtn.classList.remove('hidden');
          }
          
          // Clear the paste textarea to avoid confusion with previous data
          if (this.pasteTextarea) {
            this.pasteTextarea.value = '';
          }
        } else {
          // Player generated an answer - use the peerId from the received offer
          const finalPeerId = this.receivedPeerId || peerId;
          const answerData = {
            answer: pendingOffer,
            iceCandidates: candidates,
            peerId: finalPeerId  // Use received peerId or fallback to current
          };
          this.copyTextarea.value = JSON.stringify(answerData);
          this.updateStatus('waiting', 'Respuesta generada');
          this.showNextStep('Copia la respuesta generada y compártela con el creador. El creador debe pegarla y procesarla para completar la conexión.');
          
          // Show WhatsApp button if phone number is available
          if (this.playerPhone && this.whatsappBtn) {
            this.whatsappBtn.classList.remove('hidden');
          }
          // Show Telegram button if phone number is available
          if (this.playerPhone && this.telegramBtn) {
            this.telegramBtn.classList.remove('hidden');
          }
        }
      }
    }

    addRegisteredPlayer() {
      const playerName = this.playerRegistrationInput?.value.trim();
      if (!playerName) {
        alert('Por favor ingresa un nombre para el jugador');
        return;
      }

      // Check if player name already exists
      const existingPlayer = Array.from(this.registeredPlayers.values()).find(
        name => name.toLowerCase() === playerName.toLowerCase()
      );
      
      if (existingPlayer) {
        return;
      }

      // Generate unique player ID
      const playerId = 'player_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
      this.registeredPlayers.set(playerId, playerName);
      
      // Add player to the list
      this.updateRegisteredPlayersList();
      
      // Clear input
      if (this.playerRegistrationInput) {
        this.playerRegistrationInput.value = '';
      }
      
      // Enable start game button if we have requirements
      this.updateStartGameButtonState();
    }

