    goToVirtualTable() {
      if (!this.selectedBoardId) {
        alert('Por favor selecciona un mapa primero');
        return;
      }
      
      // Redirect to virtual table with the selected board
      const currentLang = window.location.pathname.includes('/en/') ? 'en' : 'es';
      const virtualTableUrl = `/OWASPTop10TheGame/${currentLang}/virtual-table/?boardid=${this.selectedBoardId}`;
      window.location.href = virtualTableUrl;
