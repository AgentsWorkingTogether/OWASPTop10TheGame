    async loadMaps() {
      try {
        // Show loading state
        this.mapsLoading?.classList.remove('hidden');
        this.mapsError?.classList.add('hidden');
        this.mapsGrid?.classList.add('hidden');
        
        // Fetch maps list from GitHub
        const response = await fetch('https://raw.githubusercontent.com/AgentsWorkingTogether/OWASPTop10TheGame/refs/heads/main/boards/list.json');
        const data = await response.json();
        
        console.log('Maps loaded:', data);
        
        // Hide loading, show grid
        this.mapsLoading?.classList.add('hidden');
        this.mapsGrid?.classList.remove('hidden');
        
        // Populate maps grid
        if (this.mapsGrid) {
          this.mapsGrid.innerHTML = '';
          
          data.boards.forEach((board: any) => {
            const mapCard = document.createElement('div');
            mapCard.className = 'bg-white/90 border-2 border-black rounded-lg p-4 cursor-pointer hover:bg-white transition-colors duration-200';
            mapCard.setAttribute('data-board-id', board.id);
            
            mapCard.innerHTML = `
              <div class="text-center">
                <h4 class="font-bold text-lg mb-2" style="color: var(--color-text);">${board.name}</h4>
                <p class="text-sm mb-3 opacity-75" style="color: var(--color-text);">${board.description || 'Sin descripción'}</p>
                <div class="text-xs opacity-60" style="color: var(--color-text);">
                  Dificultad: ${board.difficulty || 'N/A'}
                </div>
              </div>
            `;
            
            // Add click event
            mapCard.addEventListener('click', () => this.selectMap(board.id, board.name));
            
            this.mapsGrid.appendChild(mapCard);
          });
        }
        
      } catch (error) {
        console.error('Error loading maps:', error);
        
        // Show error state
        this.mapsLoading?.classList.add('hidden');
        this.mapsError?.classList.remove('hidden');
      }
    }

    selectMap(boardId: string, boardName: string) {
      // Remove previous selection
      const previousSelected = this.mapsGrid?.querySelector('.border-blue-500');
      if (previousSelected) {
        previousSelected.classList.remove('border-blue-500', 'bg-blue-50');
        previousSelected.classList.add('border-black', 'bg-white/90');
      }
      
      // Select new map
      const selectedCard = this.mapsGrid?.querySelector(`[data-board-id="${boardId}"]`);
      if (selectedCard) {
        selectedCard.classList.remove('border-black', 'bg-white/90');
        selectedCard.classList.add('border-blue-500', 'bg-blue-50');
      }
      
      // Store selection
      this.selectedBoardId = boardId;
      this.selectedBoardName = boardName;
      
      // Show action buttons
      if (this.mapActionButtons) {
        this.mapActionButtons.classList.remove('hidden');
      }
      
      console.log('Map selected:', boardId, boardName);
    }

