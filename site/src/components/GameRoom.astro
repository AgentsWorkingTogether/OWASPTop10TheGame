    setupPlayerName() {
      const name = this.setupPlayerNameInput?.value.trim();
      const phoneNumber = this.setupPlayerPhoneInput?.value.trim() || '';
      const dialCode = this.selectedCode?.textContent || '+34';
      const phone = phoneNumber ? `${dialCode} ${phoneNumber}` : '';
      
      if (name) {
        this.playerName = name;
        this.playerPhone = phone;
        
        // Update current player name display
        if (this.currentPlayerName) {
          this.currentPlayerName.textContent = name;
        }
        
        // For initial setup, we don't add to local players list yet
        // The players list will be populated by the players_update message
        
        // Set leader if creator
        if (this.isCreator) {
          this.leaderName = name;
          this.isLeader = true;
          this.updateLeaderDisplay();
          this.updateUptoDisplay(); // Enable upTo buttons for leader
          this.updateOwaspDisplay(); // Enable OWASP button for leader
          
          // Send leader information to all connected players
          this.sendGameVariableUpdate('leader', this.leaderName);
        }
        
        // Hide setup section and show appropriate next section
        const setupSection = document.getElementById('player-name-setup');
        if (setupSection) {
          setupSection.classList.add('hidden');
        }
        
        if (this.isCreator) {
          // Add creator to the players array
          this.allPlayersNames = [name];
          
          // Continue with game creation
          this.continueWithGameCreation();
          
          // Send initial players update with just the creator
          this.sendPlayersUpdateToAll();
        } else {
          // Continue with game joining
          this.continueWithGameJoining();
        }
        
        // Clear inputs
        if (this.setupPlayerNameInput) {
          this.setupPlayerNameInput.value = '';
        }
        if (this.setupPlayerPhoneInput) {
          this.setupPlayerPhoneInput.value = '';
        }
      } else {
        alert('Por favor ingresa un nombre');
      }
    }

