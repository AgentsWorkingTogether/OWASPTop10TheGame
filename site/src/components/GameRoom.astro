    connectToPlayer(playerId: string, playerName: string) {
      console.log('Connecting to player:', playerName);
      
      // Generate unique peer ID for this connection
      const peerId = 'peer_' + playerId + '_' + Date.now();
      console.log('Generated unique peerId:', peerId);
      this.currentPeerId = peerId;
      
      this.createPeerConnection(peerId, playerName);
    }

    createPeerConnection(peerId: string, playerName: string) {
      
      const configuration = {
        iceServers: [
          { urls: 'stun:stun.l.google.com:19302' },
          { urls: 'stun:stun1.l.google.com:19302' }
        ]
      };

      // Create new peer connection
      const peerConnection = new RTCPeerConnection(configuration);
      
      // Initialize Maps if they don't exist
      if (!this.peerConnections) {
        this.peerConnections = new Map();
      }
      if (!this.dataChannels) {
        this.dataChannels = new Map();
      }
      if (!this.iceCandidates) {
        this.iceCandidates = new Map();
      }
      if (!this.iceGatheringComplete) {
        this.iceGatheringComplete = new Map();
      }
      if (!this.pendingOffers) {
        this.pendingOffers = new Map();
      }
      
      // Store new peer connection
      this.peerConnections.set(peerId, peerConnection);

      // Set up data channel for creator
      const dataChannel = peerConnection.createDataChannel('gameChannel');
      this.dataChannels.set(peerId, dataChannel);
      this.setupDataChannel(dataChannel, peerId);

      // Handle ICE candidates for this specific peer
      peerConnection.onicecandidate = (event) => {
        if (event.candidate) {
          console.log('New ICE candidate for peer', peerId, ':', event.candidate);
          if (!this.iceCandidates.has(peerId)) {
            this.iceCandidates.set(peerId, []);
          }
          const candidates = this.iceCandidates.get(peerId);
          if (candidates) {
            candidates.push(event.candidate);
          }
        } else {
          console.log('ICE gathering complete for peer', peerId);
          this.onIceGatheringComplete(peerId);
        }
      };

      // Handle connection state changes for this specific peer
      peerConnection.onconnectionstatechange = () => {
        console.log('Connection state for peer', peerId, ':', peerConnection.connectionState);
        if (peerConnection.connectionState === 'connected') {
          this.updateStatus('connected', 'Conectado');
          this.showGameRoom();
          
          // Player is now fully connected - no additional list management needed
          // (Player was already added to allPlayersNames when the data channel opened)
          
          // TODO: Instead of removing from registered players, we should update UI state
          // this.removeConnectedPlayerFromRegistered(peerId);
        }
      };

      // Initialize ICE candidates for this peer
      this.iceCandidates.set(peerId, []);
      this.iceGatheringComplete.set(peerId, false);
      this.pendingOffers.set(peerId, undefined);

      // Create offer for this player
      peerConnection.createOffer().then((offer: RTCSessionDescriptionInit) => {
        peerConnection.setLocalDescription(offer);
        this.pendingOffers.set(peerId, offer);
        this.updateStatus('waiting', `Generando oferta para ${playerName}...`);
        this.showNextStep(`Esperando a que se generen todos los ICE candidates para ${playerName}...`);
      });
    }

    removeConnectedPlayerFromRegistered(peerId: string) {
      // Extract playerId from peerId (format: 'peer_playerId_timestamp')
      const playerIdMatch = peerId.match(/^peer_(.+)_\d+$/);
      if (playerIdMatch) {
        const playerId = playerIdMatch[1];
        
        // Remove from registered players
        if (this.registeredPlayers.has(playerId)) {
          console.log('Removing connected player from registered list:', playerId);
          this.registeredPlayers.delete(playerId);
          
          // Update the UI list
          this.updateRegisteredPlayersList();
        }
      }
    }

    updateStartGameButtonState() {
      if (this.finishRegistrationBtn) {
        // Import game rules to validate player count
        import('../config/gameRules.js').then(({ isValidPlayerCount }) => {
          const playerCount = this.allPlayersNames.length;
          const hasValidPlayerCount = isValidPlayerCount(playerCount);
          const hasMapUUID = this.mapaValue && this.mapaValue.trim() !== '';
          
          const isEnabled = hasValidPlayerCount && hasMapUUID;

          const btn = this.finishRegistrationBtn;
          if (!btn) return;

          btn.disabled = !isEnabled;

          // Update button visual state
          if (isEnabled) {
            btn.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-gray-400');
            btn.classList.add('hover:scale-105');
          } else {
            btn.classList.add('opacity-50', 'cursor-not-allowed', 'bg-gray-400');
            btn.classList.remove('hover:scale-105');
          }

          // Update button text to show current player count and valid range
          const isEnglish = document.documentElement.lang === 'en';
          const buttonText = isEnglish ? 'Start Game' : 'Iniciar Partida';
          btn.textContent = `${buttonText} (${playerCount}/5-10)`;
        }).catch(error => {
          console.error('Error al importar reglas del juego:', error);
        });
      }
    }

    finishPlayerRegistration() {
      // Validate requirements
      if (this.allPlayersNames.length <= 1) {
        alert('Se necesita al menos un jugador conectado para iniciar la partida');
        return;
      }
      
      if (!this.mapaValue || this.mapaValue.trim() === '') {
        alert('Se necesita asignar un UUID de mapa antes de iniciar la partida');
        return;
      }

      // Start the game logic
      this.startGame();
    }

    startGame() {
      console.log('Iniciando partida con', this.allPlayersNames.length, 'jugadores...');
      
      // Mark game as started
      this.gameStarted = true;
      
      // 1. Discard unconnected peers and clean up
      this.cleanupUnconnectedPeers();
      
      // 2. Send game initialization messages in order
      this.sendGameInitializationMessages();
      
      // 3. Hide registration section and WebRTC configuration, show game room
      const registrationSection = document.getElementById('player-registration-section');
      if (registrationSection) {
        registrationSection.classList.add('hidden');
      }
      
      // Hide WebRTC signaling section for creator (no longer needed)
      if (this.webrtcSignaling) {
        this.webrtcSignaling.classList.add('hidden');
      }
      

      
      this.showGameRoom();
      
      // Update UI states after game starts
      this.updateMapaDisplay(); // Disable map button
      this.updateUptoDisplay(); // Enable upTo buttons for leader
      this.updateOwaspDisplay(); // Enable OWASP button for leader
      this.updatePlayersList(); // Show leader assignment buttons
      
      // Show bad players reveal section for creator
      if (this.isCreator && this.badPlayersRevealSection) {
        this.badPlayersRevealSection.classList.remove('hidden');
        console.log('🕵️ Sección de revelación de jugadores malos mostrada para el creador');
      }
      
      console.log('Partida iniciada exitosamente');
    }

    sendGameInitializationMessages() {
      console.log('Enviando mensajes de inicialización de partida...');
      
      // 1. Send game started status to all players
      console.log('1. Enviando estado de partida iniciada');
      const gameStartedMessage = {
        type: 'game_variable',
        variable: 'game_started',
        value: true
      };
      this.broadcastToAll(gameStartedMessage);
      
      // 2. Send complete players list to all players
      console.log('2. Enviando lista completa de jugadores:', this.allPlayersNames);
      const playersListMessage = {
        type: 'players_update',
        playerNames: this.allPlayersNames
      };
      this.broadcastToAll(playersListMessage);
      
      // 3. Send character distribution information to all players
      console.log('3. Enviando información de distribución de personajes');
      import('../config/gameRules.js').then(({ getCharacterDistribution }) => {
        const totalPlayers = this.allPlayersNames.length;
        const distribution = getCharacterDistribution(totalPlayers);
        
        if (distribution) {
          const characterDistributionMessage = {
            type: 'game_variable',
            variable: 'character_distribution',
            value: {
              totalPlayers: distribution.totalPlayers,
              goodCharacters: distribution.good,
              badCharacters: distribution.bad
            }
          };
          
          console.log('📊 Enviando distribución de personajes:', characterDistributionMessage.value);
          this.broadcastToAll(characterDistributionMessage);
          
          // Also send to creator
          console.log('📊 Distribución para creador:', distribution);
        } else {
          console.error('❌ No se pudo obtener la distribución de personajes');
        }
      }).catch(error => {
        console.error('Error al obtener distribución de personajes:', error);
      });
      
      // 3. Send UpTo value to all players
      console.log('3. Enviando valor UpTo:', this.uptoValue);
      const uptoMessage = {
        type: 'game_variable',
        variable: 'upto',
        value: this.uptoValue
      };
      this.broadcastToAll(uptoMessage);
      
      // 4. Send Map UUID to all players
      console.log('4. Enviando UUID del mapa:', this.mapaValue);
      const mapaMessage = {
        type: 'game_variable',
        variable: 'mapa',
        value: this.mapaValue
      };
      this.broadcastToAll(mapaMessage);
      
              // 5. Assign and send random unique characters to all players (one by one)
        console.log('5. Asignando personajes aleatorios uno por uno...');
        this.assignRandomCharactersToPlayers();
    }

    cleanupUnconnectedPeers() {
      console.log('Limpiando peers no conectados...');
      
      // Get list of connected peer IDs from data channels that are open
      const connectedPeerIds = new Set<string>();
      this.dataChannels.forEach((channel, peerId) => {
        if (channel && channel.readyState === 'open') {
          connectedPeerIds.add(peerId);
        }
      });
      
      // Clean up peerConnections for unconnected peers
      this.peerConnections.forEach((connection, peerId) => {
        if (!connectedPeerIds.has(peerId)) {
          console.log('Removing unconnected peer:', peerId);
          connection.close();
          this.peerConnections.delete(peerId);
        }
      });
      
      // Clean up dataChannels for unconnected peers
      this.dataChannels.forEach((channel, peerId) => {
        if (!connectedPeerIds.has(peerId)) {
          console.log('Removing unconnected data channel:', peerId);
          if (channel) {
            channel.close();
          }
          this.dataChannels.delete(peerId);
        }
      });
      
      // Clean up other maps
      this.iceCandidates.forEach((candidates, peerId) => {
        if (!connectedPeerIds.has(peerId)) {
          this.iceCandidates.delete(peerId);
        }
      });
      
      this.iceGatheringComplete.forEach((complete, peerId) => {
        if (!connectedPeerIds.has(peerId)) {
          this.iceGatheringComplete.delete(peerId);
        }
      });
      
      this.pendingOffers.forEach((offer, peerId) => {
        if (!connectedPeerIds.has(peerId)) {
          this.pendingOffers.delete(peerId);
        }
      });
      
      // Update players map to only include connected players
      const connectedPlayers = new Map<string, string>();
      this.players.forEach((playerName, peerId) => {
        if (connectedPeerIds.has(peerId)) {
          connectedPlayers.set(peerId, playerName);
        }
      });
      this.players = connectedPlayers;
      
      console.log('Cleanup completado. Peers conectados:', connectedPeerIds.size);
    }

    assignRandomCharactersToPlayers() {
      console.log('Generando y asignando personajes aleatorios...');
      
      // Import both characters and game rules
      Promise.all([
        import('../config/characters.js'),
        import('../config/gameRules.js')
      ]).then(([{ getAllCharacters }, { getCharacterDistribution }]) => {
        const allCharacters = getAllCharacters();
        
        // Total players = creator + connected players
        const totalPlayers = this.allPlayersNames.length;
        console.log('Total de jugadores:', totalPlayers);
        
        // Get character distribution for this player count
        const distribution = getCharacterDistribution(totalPlayers);
        if (!distribution) {
          console.error(`❌ Número de jugadores no válido: ${totalPlayers}`);
          return;
        }
        
        console.log(`📊 Distribución para ${totalPlayers} jugadores:`, distribution);
        
        // Separate characters by type
        const goodCharacters = allCharacters.filter(char => char.type === 'good');
        const badCharacters = allCharacters.filter(char => char.type === 'bad');
        
        // Ensure we have enough characters of each type
        if (goodCharacters.length < distribution.good) {
          console.warn(`⚠️ No hay suficientes personajes buenos: ${goodCharacters.length} < ${distribution.good}`);
        }
        if (badCharacters.length < distribution.bad) {
          console.warn(`⚠️ No hay suficientes personajes malos: ${badCharacters.length} < ${distribution.bad}`);
        }
        
        // Shuffle character arrays
        const shuffleArray = (array: any[]) => {
          for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
          }
          return array;
        };
        
        // Create character pool according to distribution rules
        const characterPool: string[] = [];
        
        // Add good characters (including CISO) randomly
        const shuffledGood = shuffleArray([...goodCharacters]);
        for (let i = 0; i < distribution.good && i < shuffledGood.length; i++) {
          characterPool.push(shuffledGood[i].key);
        }
        
        // Add bad characters according to distribution
        const shuffledBad = shuffleArray([...badCharacters]);
        for (let i = 0; i < distribution.bad && i < shuffledBad.length; i++) {
          characterPool.push(shuffledBad[i].key);
        }
        
        // Shuffle the final pool
        shuffleArray(characterPool);
        
        console.log(`🎭 Pool de personajes creado: ${characterPool.length} personajes`);
        console.log(`📊 Distribución: ${distribution.good} buenos, ${distribution.bad} malos`);
        console.log('Personajes en el pool:', characterPool);
        
        // Verify the pool matches the distribution rules
        const goodInPool = characterPool.filter(char => goodCharacters.some(good => good.key === char)).length;
        const badInPool = characterPool.filter(char => badCharacters.some(bad => bad.key === char)).length;
        console.log(`✅ Verificación: ${goodInPool} buenos, ${badInPool} malos en el pool`);
        
        // Assign characters to players sequentially
        let characterIndex = 0;
        
        // Assign to creator first
        if (characterIndex < characterPool.length) {
          const creatorCharacter = characterPool[characterIndex];
          console.log(`👑 Asignando personaje ${creatorCharacter} al creador`);
          this.updatePlayerCharacterDisplay(creatorCharacter);
          this.playerCharacters.set(this.playerName, creatorCharacter);
          characterIndex++;
        }
        
        // Assign to connected players
        this.dataChannels.forEach((channel, peerId) => {
          if (channel && channel.readyState === 'open' && characterIndex < characterPool.length) {
            const assignedCharacter = characterPool[characterIndex];
            const playerName = this.allPlayersNames[characterIndex]; // +1 because creator is at index 0
            
            console.log(`🎯 Asignando personaje ${assignedCharacter} a ${playerName} (peer: ${peerId})`);
            
            // Store the character assignment
            this.playerCharacters.set(playerName, assignedCharacter);
            
            // Send assigned character to this specific player
            const characterMessage = {
              type: 'game_variable',
              variable: 'player_character',
              value: assignedCharacter
            };
            
            console.log(`Enviando personaje ${assignedCharacter} a ${playerName}:`, characterMessage);
            channel.send(JSON.stringify(characterMessage));
            
            console.log(`✅ Personaje ${assignedCharacter} enviado exitosamente a ${playerName} (peer: ${peerId})`);
            characterIndex++;
          } else if (channel && channel.readyState === 'open') {
            console.log(`❌ No hay más personajes disponibles para peer ${peerId}`);
          } else {
            console.log(`❌ Canal no disponible para peer ${peerId}: existe=${!!channel}, estado=${channel?.readyState}`);
          }
        });
        
        console.log('🎉 Asignación de personajes completada según las reglas del juego.');
        console.log(`📊 Resumen: ${distribution.good} buenos, ${distribution.bad} malos, total: ${characterPool.length}`);
        console.log(`🎭 Personajes asignados: ${characterIndex} de ${totalPlayers} jugadores`);
        console.log(`🎯 CISO está en el pool: ${characterPool.includes('ciso') ? '✅ SÍ' : '❌ NO'}`);
        
        // Update the character count display
        this.updateCharacterCounts(goodInPool, badInPool);
      }).catch(error => {
        console.error('Error al importar configuración:', error);
      });
    }

    broadcastToAll(message: any) {
      if (!this.dataChannels) {
        console.log('❌ No hay canales de datos para broadcast');
        return;
      }
      
      console.log(`📡 Broadcasting mensaje tipo "${message.variable}" a ${this.dataChannels.size} canales:`, message);
      
      let sentCount = 0;
      this.dataChannels.forEach((channel, peerId) => {
        if (channel && channel.readyState === 'open') {
          channel.send(JSON.stringify(message));
          console.log(`✅ Mensaje enviado a peer ${peerId}`);
          sentCount++;
        } else {
          console.log(`❌ Canal no disponible para peer ${peerId}: existe=${!!channel}, estado=${channel?.readyState}`);
        }
      });
      
      console.log(`📡 Broadcast completado: ${sentCount} mensajes enviados de ${this.dataChannels.size} canales totales`);
    }

