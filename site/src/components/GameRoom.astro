    getPlayerNameForPeer(peerId: string): string | null {
      // Find the player name from registered players based on peerId
      // The peerId contains the playerId, so we need to extract it
      for (const [playerId, playerName] of this.registeredPlayers) {
        if (peerId.includes(playerId)) {
          return playerName;
        }
      }
      return null;
    }

    broadcastToOthers(message: any, senderId: string) {
      if (!this.dataChannels) return;
      
      this.dataChannels.forEach((channel, peerId) => {
        if (peerId !== senderId && channel && channel.readyState === 'open') {
          channel.send(JSON.stringify(message));
        }
      });
    }

    sendPlayersUpdateToAll() {
      if (!this.isCreator) return;
      
      const playersUpdateMessage = {
        type: 'players_update',
        playerNames: this.allPlayersNames
      };
      
      console.log('Sending players update to all:', this.allPlayersNames);
      
      // Send to all connected players
      this.broadcastToAll(playersUpdateMessage);
      
      // Also process locally for creator
      this.processPlayersUpdate(this.allPlayersNames);
      
      // Update registered players list to show connection status
      this.updateRegisteredPlayersList();
      
      // Update start game button state
      this.updateStartGameButtonState();
    }

    processPlayersUpdate(playerNames: string[]) {
      console.log('Processing players update locally:', playerNames);
      console.log('Current player name is:', this.playerName);
      
      // Clear current players list and rebuild from names
      this.players.clear();
      
      // Update allPlayersNames with the received list
      this.allPlayersNames = [...playerNames];
      console.log('Updated allPlayersNames:', this.allPlayersNames);
      
      // Add all players from the list
      if (playerNames && Array.isArray(playerNames)) {
        playerNames.forEach((name: string, index: number) => {
          // Assign unique IDs to each player
          this.players.set(`player_${index}`, name);
          console.log(`Added player ${index}: ${name}`);
        });
      }
      
      console.log('Players map after update:', this.players);
      
      // Update UI
      this.updatePlayersList();
      
      // Update connected players count
      if (this.connectedPlayers) {
        this.connectedPlayers.textContent = playerNames.length.toString();
      }
    }

    generateNewOffer() {
      if (!this.isCreator) return;
      
      console.log('Generating new offer for additional player...');
      
      // Generate unique peer ID for new connection
      const peerId = 'peer_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
      this.currentPeerId = peerId;
      
      const configuration = {
        iceServers: [
          { urls: 'stun:stun.l.google.com:19302' },
          { urls: 'stun:stun1.l.google.com:19302' }
        ]
      };

      // Create new peer connection (don't cleanup existing ones)
      const peerConnection = new RTCPeerConnection(configuration);
      
      // Initialize Maps if they don't exist
      if (!this.peerConnections) {
        this.peerConnections = new Map();
      }
      if (!this.dataChannels) {
        this.dataChannels = new Map();
      }
      if (!this.iceCandidates) {
        this.iceCandidates = new Map();
      }
      if (!this.iceGatheringComplete) {
        this.iceGatheringComplete = new Map();
      }
      if (!this.pendingOffers) {
        this.pendingOffers = new Map();
      }
      
      // Store new peer connection
      this.peerConnections.set(peerId, peerConnection);

      // Set up data channel for creator
      const dataChannel = peerConnection.createDataChannel('gameChannel');
      this.dataChannels.set(peerId, dataChannel);
      this.setupDataChannel(dataChannel, peerId);

      // Handle ICE candidates for this specific peer
      peerConnection.onicecandidate = (event) => {
        if (event.candidate) {
          console.log('New ICE candidate for peer', peerId, ':', event.candidate);
          if (!this.iceCandidates.has(peerId)) {
            this.iceCandidates.set(peerId, []);
          }
          const candidates = this.iceCandidates.get(peerId);
          if (candidates) {
            candidates.push(event.candidate);
          }
        } else {
          console.log('ICE gathering complete for peer', peerId);
          this.onIceGatheringComplete(peerId);
        }
      };

      // Handle connection state changes for this specific peer
      peerConnection.onconnectionstatechange = () => {
        console.log('Connection state for peer', peerId, ':', peerConnection.connectionState);
        if (peerConnection.connectionState === 'connected') {
          this.updateStatus('connected', 'Conectado');
          this.showGameRoom();
          
          // For generateNewOffer, we don't have a specific player name registered
          // This is for generic new connections, player name will be assigned later
          
          // TODO: Handle UI state for generic connections
          // this.removeConnectedPlayerFromRegistered(peerId);
        }
      };

      // Initialize ICE candidates for this peer
      this.iceCandidates.set(peerId, []);
      this.iceGatheringComplete.set(peerId, false);
      this.pendingOffers.set(peerId, undefined);

      // Create offer for new player
      peerConnection.createOffer().then((offer: RTCSessionDescriptionInit) => {
        peerConnection.setLocalDescription(offer);
        this.pendingOffers.set(peerId, offer);
        this.updateStatus('waiting', 'Generando ICE candidates para nuevo jugador...');
        this.showNextStep('Esperando a que se generen todos los ICE candidates para el nuevo jugador...');
      });


    }

    showGameRoom() {
      // For creator, keep signaling section visible ONLY if game hasn't started yet
      if (this.isCreator) {
        this.gameRoom?.classList.remove('hidden');
        
        // Only show WebRTC signaling if game hasn't started yet
        if (this.webrtcSignaling) {
          if (this.gameStarted) {
            // Game has started - hide WebRTC configuration
            this.webrtcSignaling.classList.add('hidden');
          } else {
            // Game hasn't started - keep signaling visible for adding players
            this.webrtcSignaling.classList.remove('hidden');
          }
        }
        

      } else {
        // For players, always hide signaling section and new player section
        this.webrtcSignaling?.classList.add('hidden');
        this.gameRoom?.classList.remove('hidden');

      }
      
      if (this.gameCodeDisplay && this.gameCode) {
        this.gameCodeDisplay.textContent = this.gameCode;
      }
      
      // Hide next step info when game room is shown
      this.nextStepInfo?.classList.add('hidden');
      this.hidePasteInstruction();
      
      // Initialize game variables display
      this.updateUptoDisplay();
      this.updateLeaderDisplay();
      this.updateMapaDisplay();
      this.updateOwaspDisplay();
    }

    sendMessage(message: string) {
      // Send message to all connected data channels
      if (this.dataChannels) {
        this.dataChannels.forEach((channel) => {
          if (channel && channel.readyState === 'open') {
            channel.send(message);
            this.messagesSent++;
          }
        });
      }
    }

