---
import { Image } from 'astro:assets';
import { getTranslationKey, type Language } from '../utils/i18n';
import whatsappImage from '../assets/images/128px-WhatsApp.svg.png';
import telegramImage from '../assets/images/128px-Telegram_logo.svg.png';

interface Props {
  translations: any;
  lang: Language;
}

const { translations, lang } = Astro.props;
---

  <div id="game-setup" class="space-y-8">
    <!-- Game Creation Section -->
    <div class="max-w-md mx-auto card-bg rounded-lg p-6 text-center">
      <h2 class="text-2xl font-bold mb-4 section-title">
        {getTranslationKey(translations, 'game.create_new_game')}
      </h2>
      <p class="mb-6">
        {getTranslationKey(translations, 'game.create_new_game_desc')}
      </p>
      <button 
        id="create-game-btn"
        class="btn-primary py-3 px-8 text-lg"
      >
        {getTranslationKey(translations, 'game.create_game')}
      </button>
    </div>


  </div>

  <!-- Map Selection Section -->
  <div id="map-selection" class="hidden space-y-8 mt-12">
    <div class="max-w-4xl mx-auto card-bg rounded-lg p-6 text-center">
      <h3 class="text-xl font-bold mb-4 section-title">
        {getTranslationKey(translations, 'game.select_map')}
      </h3>
      <p class="mb-6">
        {getTranslationKey(translations, 'game.select_map_desc')}
      </p>
      
      <!-- Map Grid -->
      <div id="maps-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
        <!-- Maps will be loaded here dynamically -->
      </div>
      
      <!-- Loading State -->
      <div id="maps-loading" class="text-center py-8">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-white mx-auto mb-4"></div>
        <p>{getTranslationKey(translations, 'game.loading_maps')}</p>
      </div>
      
      <!-- Error State -->
      <div id="maps-error" class="hidden text-center py-8">
        <p class="text-red-400 mb-4">{getTranslationKey(translations, 'game.maps_error')}</p>
        <button 
          id="retry-maps-btn"
          class="btn-primary py-2 px-4"
        >
          {getTranslationKey(translations, 'game.retry')}
        </button>
      </div>
      
      <!-- Action Buttons -->
      <div id="map-action-buttons" class="hidden space-y-4">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button 
            id="continue-to-player-setup-btn"
            class="btn-primary py-3 px-8 text-lg"
          >
            {getTranslationKey(translations, 'game.play_full_digital')}
          </button>
          <button 
            id="go-to-virtual-table-btn"
            class="btn-primary py-3 px-8 text-lg"
          >
            {getTranslationKey(translations, 'game.view_digital_map')}
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Player Name Setup Section -->
  <div id="player-name-setup" class="hidden space-y-8 mt-12">
    <div class="max-w-md mx-auto card-bg rounded-lg p-6 text-center">
      <h3 class="text-xl font-bold mb-4 section-title">
        {getTranslationKey(translations, 'game.player_setup')}
      </h3>
      <div class="mb-6">
        <p class="text-lg font-semibold mb-2">
          {getTranslationKey(translations, 'game.player_setup_desc')}
        </p>
        <p>
          {getTranslationKey(translations, 'game.player_setup_desc2')}
        </p>
      </div>

      <!-- Player Name and Phone Input -->
      <div class="flex flex-col gap-4">
        <input 
          type="text" 
          id="setup-player-name-input"
          placeholder={getTranslationKey(translations, 'game.enter_name')}
          class="w-full bg-white/90 border-2 border-black rounded-lg px-4 py-2 placeholder-gray-600 focus:outline-none focus:border-blue-400"
          style="color: var(--color-text); font-family: 'Special Elite', monospace;"
        />
        <div class="relative">
          <div class="flex items-center bg-white/90 border-2 border-black rounded-lg overflow-hidden">
            <button 
              type="button"
              id="country-selector"
              class="flex items-center px-3 py-2 bg-gray-100 border-r-2 border-black hover:bg-gray-200 transition-colors"
            >
              <span id="selected-flag" class="text-lg mr-2">🇪🇸</span>
              <span id="selected-code" class="text-sm font-medium">+34</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <input 
              type="tel" 
              id="setup-player-phone-input"
              placeholder={getTranslationKey(translations, 'game.enter_phone')}
              class="flex-1 px-4 py-2 bg-transparent border-none outline-none placeholder-gray-600"
              style="color: var(--color-text); font-family: 'Special Elite', monospace;"
            />
          </div>
          <div id="country-dropdown" class="hidden absolute top-full left-0 w-full bg-white border-2 border-black rounded-lg mt-1 max-h-48 overflow-y-auto z-50">
            <!-- Countries will be populated here -->
          </div>
        </div>
        <button 
          id="setup-name-btn"
          class="btn-primary py-3 px-8 text-lg"
        >
          {getTranslationKey(translations, 'game.continue')}
        </button>
      </div>
    </div>
  </div>

  <!-- WebRTC and Player Registration Section -->
  <div id="webrtc-signaling" class="hidden mt-12">
        <div id="webrtc-container" class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <!-- Player Registration -->
      <div id="player-registration-section" class="card-bg rounded-lg p-8 min-h-[400px] hidden">
        <h3 class="text-xl font-bold mb-4 text-left" style="color: var(--color-primary);">
          {getTranslationKey(translations, 'game.player_registration')}
        </h3>
        <div class="w-16 sm:w-24 h-1 bg-red-600 mb-4"></div>
        <div class="mb-4">
          <p class="text-lg font-semibold mb-2">
            {getTranslationKey(translations, 'game.player_registration_desc')}
          </p>
          <p>
            {getTranslationKey(translations, 'game.player_registration_desc2')}
          </p>
        </div>

        <!-- Player Registration Input -->
        <div class="flex gap-4 mb-4">
          <input 
            type="text" 
            id="player-registration-input"
            placeholder={getTranslationKey(translations, 'game.player_name')}
            class="flex-1 bg-white/90 border-2 border-black rounded-lg px-4 py-2 placeholder-gray-600 focus:outline-none focus:border-blue-400"
            style="color: var(--color-text); font-family: 'Special Elite', monospace;"
          />
          <button 
            id="add-player-btn"
            class="btn-primary py-3 px-6 text-lg"
          >
            {getTranslationKey(translations, 'game.add')}
          </button>
        </div>

        <!-- Registered Players List -->
        <div id="registered-players-list" class="space-y-2 max-h-64 overflow-y-auto">
          <!-- Players will be added here dynamically -->
        </div>


      </div>

      <!-- WebRTC Configuration -->
      <div class="card-bg rounded-lg p-8 min-h-[400px]">
        <h3 class="text-xl font-bold mb-4 text-left" style="color: var(--color-primary);">
          {getTranslationKey(translations, 'game.webrtc_setup')}
        </h3>
        <div class="w-16 sm:w-24 h-1 bg-red-600 mb-4"></div>
        
        <!-- Copy Section (for players joining via URL) -->
        <div id="copy-section" class="mb-6 hidden">
          <h4 class="text-lg font-semibold mb-2 text-left" style="color: var(--color-primary);">
            {getTranslationKey(translations, 'game.copy_and_share')}
          </h4>
          <div class="w-16 sm:w-24 h-1 bg-red-600 mb-2"></div>
          <div class="relative">
            <textarea 
              id="copy-textarea"
              readonly
              class="w-full h-40 bg-white/90 border-2 border-black rounded-lg p-3 font-mono text-sm resize-none pr-20"
              style="color: var(--color-accent-red);"
              placeholder={getTranslationKey(translations, 'game.copy_placeholder')}
            ></textarea>
            <div class="absolute top-2 right-2 flex flex-col gap-2">
              <button 
                id="copy-btn"
                class="btn-primary py-1 px-3 text-xs"
              >
                {getTranslationKey(translations, 'game.copy')}
              </button>
                                          <button 
                id="whatsapp-btn"
                class="btn-primary py-2 px-1 hidden"
              >
                <Image src={whatsappImage} alt="WhatsApp" class="w-5 h-5" />
              </button>
              <button 
                id="telegram-btn"
                class="btn-primary py-2 px-1 hidden"
              >
                <Image src={telegramImage} alt="Telegram" class="w-5 h-5" />
              </button>
            </div>
          </div>
          <p class="text-sm mt-2">
            {getTranslationKey(translations, 'game.copy_desc')}
          </p>
        </div>
        
        <!-- Paste Section -->
        <div id="paste-section" class="mb-6">
          <h4 class="text-lg font-semibold mb-2 text-left" style="color: var(--color-primary);">
            {getTranslationKey(translations, 'game.paste_and_process')}
          </h4>
          <div class="w-16 sm:w-24 h-1 bg-red-600 mb-2"></div>
          <div class="relative">
            <textarea
              id="paste-textarea"
              placeholder={getTranslationKey(translations, 'game.paste_placeholder')}
              class="w-full h-48 bg-white/90 border-2 border-black rounded-lg p-3 font-mono text-sm resize-none pr-20"
              style="color: var(--color-primary);"
            ></textarea>
            <button 
              id="paste-btn"
              class="btn-primary py-1 px-3 text-xs absolute top-2 right-2"
            >
              {getTranslationKey(translations, 'game.paste')}
            </button>
          </div>
          <button 
            id="process-btn"
            class="btn-primary mt-2 py-2 px-4"
          >
            Unir Jugador
          </button>
        </div>

        <!-- Start Game Button (Creator Only) -->
        <div id="start-game-section" class="mt-8 pt-6 border-t-2 border-black hidden">
          <button 
            id="finish-registration-btn"
            class="btn-primary py-3 px-8 text-lg w-full disabled:opacity-50 disabled:cursor-not-allowed disabled:bg-gray-400 disabled:hover:scale-100"
            disabled
          >
            {getTranslationKey(translations, 'game.start_game')}
          </button>
        </div>
      </div>
    </div>
  </div>



  <!-- Game Room Section -->
  <div id="game-room" class="hidden space-y-8 mt-12">
    <div class="card-bg rounded-lg p-8">
              <h3 class="text-xl font-bold mb-4 text-left" style="color: var(--color-primary);">
          {getTranslationKey(translations, 'game.game_room')} <span id="game-code-display"></span>
        </h3>
      <div class="w-16 sm:w-24 h-1 bg-red-600 mb-4"></div>
      <div id="game-info">
                  <p><strong>{getTranslationKey(translations, 'game.connected_players')}</strong> <span id="connected-players">0</span></p>
          <p><strong>{getTranslationKey(translations, 'game.your_name')}</strong> <span id="current-player-name" style="color: var(--color-primary);"></span></p>
      </div>

      <!-- Players List Section -->
      <div id="players-list-section" class="mt-4 p-4 card-bg rounded-lg">
        <h4 class="text-lg font-semibold mb-2 text-left" style="color: var(--color-primary);">
          {getTranslationKey(translations, 'game.players_in_game')}
        </h4>
        <div class="w-16 sm:w-24 h-1 bg-red-600 mb-2"></div>
        <div id="players-list" class="space-y-2">
          <!-- Players will be listed here -->
        </div>
      </div>


      <!-- Game Variables Section -->
      <div id="game-variables-section" class="mt-6 p-4 card-bg rounded-lg">
        <h4 class="text-lg font-semibold mb-4 section-title">
          {getTranslationKey(translations, 'game.game_variables')}
        </h4>
        
        <!-- Leader Variable -->
        <div class="mb-4 p-3 bg-white/90 rounded-lg border border-gray-300">
          <div class="flex items-center justify-between">
            <span class="font-medium">
              {getTranslationKey(translations, 'game.leader')}
            </span>
            <span id="leader-name" class="text-blue-600 font-bold">
              {getTranslationKey(translations, 'game.not_assigned')}
            </span>
          </div>
        </div>
        
        <!-- Player Character Variable -->
        <div class="mb-4 p-3 bg-white/90 rounded-lg border border-gray-300">
          <div class="flex items-center justify-between">
            <span class="font-medium">
              {getTranslationKey(translations, 'game.your_character')}
            </span>
            <span id="player-character" class="text-yellow-600 font-bold text-xl">
              {getTranslationKey(translations, 'game.not_assigned')}
            </span>
          </div>
        </div>
        
        <!-- UpTO Variable -->
        <div class="p-3 bg-white/90 rounded-lg mb-4 border border-gray-300">
          <div class="flex items-center justify-between mb-2">
            <span class="font-medium">
              {getTranslationKey(translations, 'game.upto')}
            </span>
            <span id="upto-value" class="text-green-600 font-bold text-xl">5</span>
          </div>
          <div class="flex gap-2 justify-center">
            <button 
              id="decrease-upto-btn"
              class="btn-primary py-2 px-4 disabled:opacity-50 disabled:cursor-not-allowed"
              disabled
            >
              {getTranslationKey(translations, 'game.decrease')}
            </button>
            <button 
              id="increase-upto-btn"
              class="btn-primary py-2 px-4 disabled:opacity-50 disabled:cursor-not-allowed"
              disabled
            >
              {getTranslationKey(translations, 'game.increase')}
            </button>
          </div>
        </div>

        <!-- Mapa Variable -->
        <div class="p-3 bg-white/90 rounded-lg mb-4 border border-gray-300">
          <div class="flex items-center justify-between mb-2">
            <span class="font-medium">
              {getTranslationKey(translations, 'game.map')}
            </span>
            <span id="mapa-value" class="text-green-600 font-bold text-sm font-mono">Sin asignar</span>
          </div>
          <div class="text-center">
            <span class="text-xs text-gray-600">
              {getTranslationKey(translations, 'game.map_fixed')}
            </span>
          </div>
        </div>

        <!-- OWASP Variable -->
        <div class="p-3 bg-white/90 rounded-lg border border-gray-300">
          <div class="flex items-center justify-between mb-2">
            <span class="text-purple-600 font-bold text-sm">Vacío</span>
          </div>
          <div class="flex gap-2 justify-center">
            <button 
              id="set-owasp-btn"
              class="btn-primary py-2 px-4 disabled:opacity-50 disabled:cursor-not-allowed"
              disabled
            >
              {getTranslationKey(translations, 'game.set_owasp')}
            </button>
          </div>
        </div>
        
        <!-- Character Count Variables -->
        <div class="p-3 bg-white/90 rounded-lg border border-gray-300">
          <div class="flex items-center justify-between mb-2">
            <span class="font-medium">
              Buenos:
            </span>
            <span id="good-characters-count" class="text-green-600 font-bold text-xl">0</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="font-medium">
              No tan Buenos:
            </span>
            <span id="bad-characters-count" class="text-red-600 font-bold text-xl">0</span>
          </div>
        </div>
        
              <!-- Bad Players Reveal Section (only visible to creator after game starts) -->
      <div id="bad-players-reveal-section" class="p-4 bg-red-50 rounded-lg border border-red-300 hidden">
        <h4 class="text-lg font-semibold text-red-700 mb-3 text-center">
          🕵️ Revelar Jugadores Malos
        </h4>
        <div class="text-center space-y-4">
          <button 
            id="bad-players-reveal-btn"
            class="btn-primary bg-red-600 hover:bg-red-700 text-white py-3 px-6 text-lg min-w-[200px]"
          >
            🕵️ Revelar Jugadores Malos
          </button>
          <p class="text-sm text-red-600">
            Los jugadores malos y el CISO verán a los malos marcados en rojo durante 10 segundos
          </p>
        </div>
      </div>
      </div>
    </div>
  </div>
</div>

  <!-- QR Modal -->
  <div id="qr-modal" class="hidden fixed inset-0 bg-black/60 z-50 items-center justify-center p-4">
    <div class="relative bg-white rounded-lg p-4 w-full max-w-sm shadow-xl border-2 border-black">
      <button id="qr-close-btn" class="absolute top-2 right-2 text-black hover:text-red-600 font-bold">✕</button>
      <h4 class="text-lg font-semibold mb-3 text-center" style="color: var(--color-primary);">Código QR</h4>
      <img id="qr-image" alt="QR Code" class="mx-auto w-[280px] h-[280px] object-contain border border-gray-300 rounded" />
    </div>
  </div>

<script>
  class WebRTCGame {
    private peerConnections: Map<string, RTCPeerConnection> = new Map(); // peerId -> RTCPeerConnection
    private dataChannels: Map<string, RTCDataChannel> = new Map(); // peerId -> RTCDataChannel
    private currentPeerId: string | null = null;
    private isCreator: boolean = false;
    private gameCode: string | null = null;
    private messagesSent: number = 0;
    private messagesReceived: number = 0;
    private iceCandidates: Map<string, RTCIceCandidate[]> = new Map(); // peerId -> RTCIceCandidate[]
    private iceGatheringComplete: Map<string, boolean> = new Map(); // peerId -> boolean
    private pendingOffers: Map<string, RTCSessionDescriptionInit | undefined> = new Map(); // peerId -> RTCSessionDescriptionInit
    private isInitialized: boolean = false;
    
    // DOM elements
    private createGameBtn: HTMLButtonElement | null = null;


    private gameSetup: HTMLElement | null = null;
    private webrtcSignaling: HTMLElement | null = null;
    private gameRoom: HTMLElement | null = null;
    private offerTextarea: HTMLTextAreaElement | null = null;
    private answerTextarea: HTMLTextAreaElement | null = null;
    private processBtn: HTMLButtonElement | null = null;
    private copyTextarea: HTMLTextAreaElement | null = null;
    private pasteTextarea: HTMLTextAreaElement | null = null;
    private copyBtn: HTMLButtonElement | null = null;
    private whatsappBtn: HTMLButtonElement | null = null;
    private telegramBtn: HTMLButtonElement | null = null;
    private pasteBtn: HTMLButtonElement | null = null;
    private nextStepInfo: HTMLElement | null = null;
    private nextStepText: HTMLElement | null = null;
    private pasteInstruction: HTMLElement | null = null;
    private statusIndicator: HTMLElement | null = null;
    private statusText: HTMLElement | null = null;
    private gameCodeDisplay: HTMLElement | null = null;
    private gameCodeDisplaySignaling: HTMLElement | null = null;
    private copyGameCodeBtn: HTMLButtonElement | null = null;
    private connectedPlayers: HTMLElement | null = null;
    private setupPlayerNameInput: HTMLInputElement | null = null;
    private setupPlayerPhoneInput: HTMLInputElement | null = null;
    private setupNameBtn: HTMLButtonElement | null = null;
    private playersList: HTMLElement | null = null;
    private currentPlayerName: HTMLElement | null = null;
    
    // Player registration elements
    private playerRegistrationInput: HTMLInputElement | null = null;
    private addPlayerBtn: HTMLButtonElement | null = null;
    private registeredPlayersList: HTMLElement | null = null;
    private finishRegistrationBtn: HTMLButtonElement | null = null;
    private leaderNameElement: HTMLElement | null = null;
    private playerNumberElement: HTMLElement | null = null;
    private playerCharacterElement: HTMLElement | null = null;
    private uptoValueElement: HTMLElement | null = null;
    private decreaseUptoBtn: HTMLButtonElement | null = null;
    private increaseUptoBtn: HTMLButtonElement | null = null;
    private mapaValueElement: HTMLElement | null = null;
    private owaspValueElement: HTMLElement | null = null;
    private setOwaspBtn: HTMLButtonElement | null = null;
    private goodCharactersCount: HTMLElement | null = null;
    private badCharactersCount: HTMLElement | null = null;
      private badPlayersRevealBtn: HTMLButtonElement | null = null;
  private badPlayersRevealSection: HTMLElement | null = null;
    private playerName: string = '';
    private playerPhone: string = '';
    private playerCharacters: Map<string, string> = new Map(); // playerName -> characterKey
    private players: Map<string, string> = new Map(); // peerId -> playerName
    private registeredPlayers: Map<string, string> = new Map(); // playerId -> playerName
    private allPlayersNames: string[] = []; // Simple array of all player names
    private receivedPeerId: string = ''; // Store peerId from received offer
    private leaderName: string = '';
    private uptoValue: number = 5;
    private isLeader: boolean = false;
    private gameStarted: boolean = false;
    private mapaValue: string = '';
    private owaspValue: string = '';
    // QR modal elements
    private qrModal: HTMLElement | null = null;
    private qrImage: HTMLImageElement | null = null;
    private qrCloseBtn: HTMLButtonElement | null = null;
    
    // Country selector elements
    private countrySelector: HTMLButtonElement | null = null;
    private countryDropdown: HTMLElement | null = null;
    private selectedFlag: HTMLElement | null = null;
    private selectedCode: HTMLElement | null = null;
    private currentCountry: string = 'es';
    
    // Map selection elements
    private mapSelection: HTMLElement | null = null;
    private mapsGrid: HTMLElement | null = null;
    private mapsLoading: HTMLElement | null = null;
    private mapsError: HTMLElement | null = null;
    private retryMapsBtn: HTMLButtonElement | null = null;
    private continueToPlayerSetupBtn: HTMLButtonElement | null = null;
    private goToVirtualTableBtn: HTMLButtonElement | null = null;
    private mapActionButtons: HTMLElement | null = null;
    private selectedBoardId: string = '';
    private selectedBoardName: string = '';

    constructor() {
      this.initializeElements();
      this.bindEvents();
      this.checkURLParameters();
    }

    checkURLParameters() {
      const urlParams = new URLSearchParams(window.location.search);
      const gameId = urlParams.get('gameId');
      const encodedData = urlParams.get('data');
      const phoneParam = urlParams.get('phone');
      
      if (gameId && encodedData) {
        console.log('URL parameters detected, auto-joining game...');
        
        try {
          // Decode the data from base64
          const decodedData = atob(encodedData);
          
          // Set the game code and ensure this is NOT a creator
          this.gameCode = gameId;
          this.isCreator = false;
          

          
          // Initialize WebRTC
          this.peerConnections = new Map();
          this.dataChannels = new Map();
          this.iceCandidates = new Map();
          this.iceGatheringComplete = new Map();
          this.pendingOffers = new Map();
          
          // Hide game setup and show WebRTC section with paste functionality
          this.gameSetup?.classList.add('hidden');
          this.webrtcSignaling?.classList.remove('hidden');
          
          // Hide all sections except copy section for players joining via URL
          const gameCodeSection = document.getElementById('game-code-section');
          const connectionStatus = document.getElementById('connection-status');
          const pasteSection = document.getElementById('paste-section');
          const copySection = document.getElementById('copy-section');
          const playerRegistrationSection = document.getElementById('player-registration-section');
          
          if (gameCodeSection) gameCodeSection.classList.add('hidden');
          if (connectionStatus) connectionStatus.classList.add('hidden');
          if (pasteSection) pasteSection.classList.add('hidden');
          if (copySection) copySection.classList.remove('hidden');
          if (playerRegistrationSection) playerRegistrationSection.classList.add('hidden');
          
          // Store phone number if provided in URL
          if (phoneParam) {
            this.playerPhone = decodeURIComponent(phoneParam);
            console.log('Phone number from URL:', this.playerPhone);
          }
          
          // Center the WebRTC container when only showing WebRTC section
          const webrtcContainer = document.getElementById('webrtc-container');
          if (webrtcContainer) {
            webrtcContainer.classList.remove('grid-cols-1', 'lg:grid-cols-2');
            webrtcContainer.classList.add('max-w-2xl', 'mx-auto');
          }
          
          // Hide start game button for players joining via URL
          const startGameSection = document.getElementById('start-game-section');
          if (startGameSection) {
            startGameSection.classList.add('hidden');
          }
          
          // Update page title for players joining via URL
          this.updatePageTitle('game.waiting_room');
          
          // Initialize WebRTC for joining
          this.initializeWebRTC();
          
          // Process the data automatically without asking for name
          if (this.pasteTextarea) {
            this.pasteTextarea.value = decodedData;
          }
          
          // Process the connection data immediately
          this.processPastedData();
          
          // Show message for URL joining
          this.updateStatus('waiting', 'Procesando conexión automática...');
          this.showNextStep('Copia la respuesta generada y compártela con el creador para completar la conexión.');
          
          // Clear URL parameters to avoid re-processing on refresh
          const newUrl = window.location.origin + window.location.pathname;
          window.history.replaceState({}, document.title, newUrl);
          
        } catch (error) {
          console.error('Error processing URL parameters:', error);
          alert('Error al procesar los parámetros de la URL');
        }
      }
    }

