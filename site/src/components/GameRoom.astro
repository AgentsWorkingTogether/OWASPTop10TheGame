            console.log(`✅ Añadiendo botón "Hacer Líder" para ${name}`);
            const makeLeaderBtn = document.createElement('button');
            makeLeaderBtn.className = 'bg-blue-600 hover:bg-blue-700 text-white font-bold py-1 px-3 rounded text-sm transition-colors duration-200';
            makeLeaderBtn.textContent = 'Hacer Líder';
            makeLeaderBtn.onclick = () => this.assignLeadership(name);
            rightSection.appendChild(makeLeaderBtn);
          } else {
            console.log(`❌ No se añade botón para ${name}`);
          }
          
          playerDiv.appendChild(leftSection);
          playerDiv.appendChild(rightSection);
          if (this.playersList) {
            this.playersList.appendChild(playerDiv);
          }
        });
        
        // Update connected players count
        if (this.connectedPlayers) {
          this.connectedPlayers.textContent = this.allPlayersNames.length.toString();
        }
      }
    }

    continueWithGameCreation() {
      if (this.gameSetup) {
        this.gameSetup.classList.add('hidden');
      }
      
      if (this.gameCodeDisplaySignaling && this.gameCode) {
        this.gameCodeDisplaySignaling.textContent = this.gameCode;
      }
      
      // For creator, show player registration section
      const registrationSection = document.getElementById('player-registration-section');
      if (registrationSection) {
        registrationSection.classList.remove('hidden');
      }
      
      // Show signaling section for WebRTC
      if (this.webrtcSignaling) {
        this.webrtcSignaling.classList.remove('hidden');
      }
      
      // Ensure WebRTC container shows in two-column layout for creator
      const webrtcContainer = document.getElementById('webrtc-container');
      if (webrtcContainer) {
        webrtcContainer.classList.remove('max-w-2xl', 'mx-auto');
        webrtcContainer.classList.add('grid-cols-1', 'lg:grid-cols-2');
      }
      
      // Show start game button for creator
      const startGameSection = document.getElementById('start-game-section');
      if (startGameSection) {
        startGameSection.classList.remove('hidden');
      }
      
      // Update page title for creator
      this.updatePageTitle('game.title');
      
      // Add creator to the registered players list from the start
      if (this.playerName) {
        const creatorId = 'creator_' + Date.now();
        this.registeredPlayers.set(creatorId, this.playerName);
        this.updateRegisteredPlayersList();
        this.updateStartGameButtonState();
      }
    }

    updatePageTitle(translationKey: string) {
      const pageTitle = document.getElementById('page-title');
      if (pageTitle) {
        // Get the current language from the page
        const currentLang = document.documentElement.lang || 'es';
        const isEnglish = currentLang === 'en';
        
        // Set title based on language and type
        if (translationKey === 'game.title') {
          pageTitle.textContent = isEnglish ? 'Game Room' : 'Sala de Partida';
        } else if (translationKey === 'game.waiting_room') {
          pageTitle.textContent = isEnglish ? 'Waiting Room' : 'Sala de Espera';
        }
      }
    }

    continueWithGameJoining() {
      if (this.gameSetup) {
        this.gameSetup.classList.add('hidden');
      }
      if (this.webrtcSignaling) {
        this.webrtcSignaling.classList.remove('hidden');
      }
      
      if (this.gameCodeDisplaySignaling && this.gameCode) {
        this.gameCodeDisplaySignaling.textContent = this.gameCode;
      }
      
      // Hide player registration section for joining players
      const registrationSection = document.getElementById('player-registration-section');
      if (registrationSection) {
        registrationSection.classList.add('hidden');
      }
      
      // Center the WebRTC container when only showing WebRTC section
      const webrtcContainer = document.getElementById('webrtc-container');
      if (webrtcContainer) {
        webrtcContainer.classList.remove('grid-cols-1', 'lg:grid-cols-2');
        webrtcContainer.classList.add('max-w-2xl', 'mx-auto');
      }
      
      // Hide start game button for joining players
      const startGameSection = document.getElementById('start-game-section');
      if (startGameSection) {
        startGameSection.classList.add('hidden');
      }
      
      // Update page title for joining players
      this.updatePageTitle('game.waiting_room');
      
      this.initializeWebRTC();
      
      this.updateStatus('waiting', 'Esperando oferta...');
      this.showNextStep('Espera a que el creador genere la oferta y te la comparta. Luego pégala aquí y procesa.');
    }

    decreaseUpto() {
      if (this.isLeader && this.uptoValue > 0) {
        this.uptoValue--;
        this.updateUptoDisplay();
        this.sendGameVariableUpdate('upto', this.uptoValue);
      }
    }

    increaseUpto() {
      if (this.isLeader && this.uptoValue < 5) {
        this.uptoValue++;
        this.updateUptoDisplay();
        this.sendGameVariableUpdate('upto', this.uptoValue);
      }
    }

    updateUptoDisplay() {
      if (this.uptoValueElement) {
        this.uptoValueElement.textContent = this.uptoValue.toString();
      }
      
      // Update button states - only enable for leader AND after game starts
      if (this.decreaseUptoBtn) {
        this.decreaseUptoBtn.disabled = !this.isLeader || !this.gameStarted || this.uptoValue <= 0;
      }
      if (this.increaseUptoBtn) {
        this.increaseUptoBtn.disabled = !this.isLeader || !this.gameStarted || this.uptoValue >= 5;
      }
    }

    updateLeaderDisplay() {
      if (this.leaderNameElement) {
        this.leaderNameElement.textContent = this.leaderName || 'Sin asignar';
      }
    }

    updatePlayerCharacterDisplay(character: string) {
      if (this.playerCharacterElement) {
        this.playerCharacterElement.textContent = character;
      }
    }

    updateCharacterCounts(goodCount: number, badCount: number) {
      if (this.goodCharactersCount) {
        this.goodCharactersCount.textContent = goodCount.toString();
      }
      if (this.badCharactersCount) {
        this.badCharactersCount.textContent = badCount.toString();
      }
      console.log(`📊 Contadores actualizados: ${goodCount} buenos, ${badCount} malos`);
    }

    revealBadPlayers() {
      if (!this.isCreator) {
        console.log('❌ Solo el creador puede revelar jugadores malos');
        return;
      }

      console.log('🕵️ Iniciando revelación de jugadores malos...');
      
      // Disable the button permanently and show countdown inside it
      if (this.badPlayersRevealBtn) {
        this.badPlayersRevealBtn.disabled = true;
        this.badPlayersRevealBtn.classList.add('opacity-50', 'cursor-not-allowed');
        this.badPlayersRevealBtn.textContent = '🕵️ Revelando... 10s';
      }

      // Get list of bad players
      const badPlayersList = this.getAllBadPlayers();
      
      // Send reveal message with list of bad players to all players
      const revealMessage = {
        type: 'game_variable',
        variable: 'reveal_bad_players',
        value: {
          badPlayers: badPlayersList,
          timestamp: Date.now()
        }
      };
      
      console.log('📡 Enviando mensaje de revelación con lista de malos:', badPlayersList);
      this.broadcastToAll(revealMessage);

      // Aplicar revelación también localmente para el creador
      this.handleBadPlayersReveal(badPlayersList);

      // Start 10 second countdown
      let timeLeft = 10;
      const countdownInterval = setInterval(() => {
        timeLeft--;
        
        // Update countdown inside the button
        if (this.badPlayersRevealBtn) {
          this.badPlayersRevealBtn.textContent = `🕵️ Revelando... ${timeLeft}s`;
        }

        if (timeLeft <= 0) {
          clearInterval(countdownInterval);
          
          // Send hide message
          const hideMessage = {
            type: 'game_variable',
            variable: 'hide_bad_players',
            value: true
          };
          
          console.log('📡 Enviando mensaje para ocultar jugadores malos');
          this.broadcastToAll(hideMessage);

          // Keep button disabled permanently with final state
          if (this.badPlayersRevealBtn) {
            this.badPlayersRevealBtn.textContent = '🕵️ Revelación Completada';
            this.badPlayersRevealBtn.classList.add('bg-gray-500', 'hover:bg-gray-500');
          }

          // Ocultar también localmente en el creador
          this.handleBadPlayersHide();

          console.log('🕵️ Revelación de jugadores malos completada');
        }
      }, 1000);
    }

    getAllBadPlayers(): string[] {
      const badPlayers: string[] = [];
      
      // Check all players and identify which ones are bad
      this.allPlayersNames.forEach(playerName => {
        const character = this.playerCharacters.get(playerName);
        if (character && this.isPlayerBad(character)) {
          badPlayers.push(playerName);
        }
      });
      
      console.log('🕵️ Lista de jugadores malos identificados:', badPlayers);
      return badPlayers;
    }



    handleBadPlayersReveal(badPlayersList: string[]) {
    // Only bad players and CISO should see this effect
    const currentCharacter = this.playerCharacterElement?.textContent;
    if (!currentCharacter || (!this.isPlayerBad(currentCharacter) && currentCharacter !== 'ciso')) {
      console.log('🕵️ Jugador bueno (no malo ni CISO) - no se aplica efecto de revelación');
      return;
    }

    const isBadPlayer = this.isPlayerBad(currentCharacter);
    const isCISO = currentCharacter === 'ciso';
    console.log(`🕵️ Aplicando efecto de revelación para ${isBadPlayer ? 'jugador malo' : 'CISO'}`);
    console.log(`🕵️ Personaje actual: ${currentCharacter}`);
    console.log(`🕵️ Nombre del jugador actual: ${this.playerName}`);
    console.log(`🕵️ Lista de jugadores malos recibida:`, badPlayersList);
    console.log(`🕵️ ¿El jugador actual está en la lista de malos? ${badPlayersList.includes(this.playerName)}`);
    console.log(`🕵️ ¿Es jugador malo? ${isBadPlayer}, ¿Es CISO? ${isCISO}`);
    
    // Get all player names from the players list
    if (!this.playersList) return;

    // Mark only the bad players from the received list
    // Use a more specific selector to avoid duplicates
    const playerEntries = this.playersList.querySelectorAll('.player-entry[data-player-name]');
    console.log(`🕵️ Elementos encontrados en la lista: ${playerEntries.length}`);
    
    // Create a Set to track processed names and avoid duplicates
    const processedNames = new Set<string>();
    
    playerEntries.forEach(entry => {
      const playerName = entry.getAttribute('data-player-name');
      if (!playerName || processedNames.has(playerName)) {
        return; // Skip if no name or already processed
      }
      
      processedNames.add(playerName);
      console.log(`🕵️ Procesando elemento con nombre: ${playerName}`);
      
      if (badPlayersList.includes(playerName)) {
        const entryEl = entry as HTMLElement;
        // Store original classes to restore later
        if (!entryEl.dataset.origClass) {
          entryEl.dataset.origClass = entryEl.className;
        }
        // Apply red color and bold to the entire player entry
        entryEl.classList.add('text-red-600', 'font-bold');
        
        // Also apply to the name span specifically for better visibility
        const nameSpan = entryEl.querySelector('[data-player-name]') as HTMLElement | null;
        if (nameSpan) {
          // Store original classes to restore later
          if (!nameSpan.dataset.origClass) {
            nameSpan.dataset.origClass = nameSpan.className;
          }
          // Remove conflicting utilities so Tailwind applies red correctly
          nameSpan.classList.remove('text-white', 'font-medium');
          nameSpan.classList.add('text-red-600', 'font-bold');
        }
        
        console.log(`🕵️ ✅ Jugador malo marcado en rojo: ${playerName}`);
      } else {
        console.log(`🕵️ ❌ ${playerName} no está en la lista de malos`);
      }
    });
    
    console.log(`🕵️ Nombres únicos procesados: ${Array.from(processedNames).join(', ')}`);
    
    // Additional check: verify if current player's name should be marked
    if (badPlayersList.includes(this.playerName)) {
      console.log(`🕵️ 🔍 Verificación adicional: ${this.playerName} SÍ está en la lista de malos`);
    } else {
      console.log(`🕵️ 🔍 Verificación adicional: ${this.playerName} NO está en la lista de malos`);
    }
  }

  handleBadPlayersHide() {
    // Only bad players and CISO should see this effect
    const currentCharacter = this.playerCharacterElement?.textContent;
    if (!currentCharacter || (!this.isPlayerBad(currentCharacter) && currentCharacter !== 'ciso')) {
      console.log('🕵️ Jugador bueno (no malo ni CISO) - no se aplica efecto de ocultación');
      return;
    }

    const isBadPlayer = this.isPlayerBad(currentCharacter);
    const isCISO = currentCharacter === 'ciso';
    console.log(`🕵️ Aplicando efecto de ocultación para ${isBadPlayer ? 'jugador malo' : 'CISO'}`);
    
    // Get all player names from the players list
    if (!this.playersList) return;

    // Remove red marking from all players and restore original classes
    // Use a more specific selector to avoid duplicates
    const playerEntries = this.playersList.querySelectorAll('.player-entry[data-player-name]');
    
    // Create a Set to track processed names and avoid duplicates
    const processedNames = new Set<string>();
    
    playerEntries.forEach(entry => {
      const entryEl = entry as HTMLElement;
      const playerName = entryEl.getAttribute('data-player-name');
      if (!playerName || processedNames.has(playerName)) {
        return; // Skip if no name or already processed
      }
      
      processedNames.add(playerName);
      
      // Restore original classes for entry if available
      if (entryEl.dataset.origClass) {
        entryEl.className = entryEl.dataset.origClass;
        delete entryEl.dataset.origClass;
      } else {
        // Fallback: remove red styles
        entryEl.classList.remove('text-red-600', 'font-bold');
      }

      // Also restore name span classes if available
      const nameSpan = entryEl.querySelector('[data-player-name]') as HTMLElement | null;
      if (nameSpan) {
        if (nameSpan.dataset.origClass) {
          nameSpan.className = nameSpan.dataset.origClass;
          delete nameSpan.dataset.origClass;
        } else {
          nameSpan.classList.remove('text-red-600', 'font-bold');
        }
      }
    });
    
    console.log(`🕵️ Nombres únicos procesados para ocultación: ${Array.from(processedNames).join(', ')}`);

    console.log('🕵️ Efecto de revelación removido de todos los jugadores');
  }

  isPlayerBad(characterKey: string): boolean {
    // Check if the character is of type 'bad'
    return characterKey !== 'ciso' && ['script_kiddie', 'cracker', 'cyberterrorist', 'hacktivist'].includes(characterKey);
  }

  getPlayerCharacter(playerName: string): string {
    // Check if this is the current player
    if (playerName === this.playerName && this.playerCharacterElement) {
      return this.playerCharacterElement.textContent || 'unknown';
    }
    
    // Get character from the stored assignments
    const character = this.playerCharacters.get(playerName);
    if (character) {
      console.log(`🕵️ Personaje encontrado para ${playerName}: ${character}`);
      return character;
    }
    
    console.log(`🕵️ No se encontró personaje para: ${playerName}`);
    return 'unknown';
  }



    updatePlayerNumberDisplay(playerNumber: number) {
      if (this.playerNumberElement) {
        this.playerNumberElement.textContent = playerNumber.toString();
      }
    }

    assignLeadership(newLeaderName: string) {
      console.log(`🔍 Validando permisos de liderazgo: isLeader=${this.isLeader}, gameStarted=${this.gameStarted}`);
      
      if (!this.isLeader || !this.gameStarted) {
        console.log(`❌ No tienes permisos para asignar liderazgo: isLeader=${this.isLeader}, gameStarted=${this.gameStarted}`);
        return;
      }
      
      console.log(`Asignando liderazgo a: ${newLeaderName}`);
      
      // Update local state
      this.leaderName = newLeaderName;
      this.isLeader = false; // Current player is no longer leader
      
      // Update local displays
      this.updateLeaderDisplay();
      this.updateUptoDisplay(); // Disable upTo buttons for ex-leader
      this.updateMapaDisplay(); // Update mapa button state
      this.updateOwaspDisplay(); // Disable OWASP button for ex-leader
      this.updatePlayersList(); // Remove "Make Leader" buttons
      
      // Send leadership change to all players
      const leadershipMessage = {
        type: 'game_variable',
        variable: 'leadership_change',
        value: {
          newLeader: newLeaderName,
          previousLeader: this.playerName
        }
      };
      
      console.log('Enviando cambio de liderazgo a todos los jugadores:', leadershipMessage);
      this.broadcastToAll(leadershipMessage);
      
      // Also send standard leader variable update
      this.sendGameVariableUpdate('leader', newLeaderName);
      
      // Ensure all players know the game has started (especially the new leader)
      if (this.gameStarted) {
        const gameStartedMessage = {
          type: 'game_variable',
          variable: 'game_started',
          value: true
        };
        this.broadcastToAll(gameStartedMessage);
        console.log('🎮 Enviando confirmación de partida iniciada tras cambio de liderazgo');
      }
    }

    handleLeadershipChange(newLeaderName: string, previousLeaderName: string) {
      console.log(`Procesando cambio de liderazgo: ${previousLeaderName} → ${newLeaderName}`);
      
      // Update leader name
      this.leaderName = newLeaderName;
      
      // Check if current player is the new leader
      if (newLeaderName === this.playerName) {
        console.log('🎉 ¡Eres el nuevo líder!');
        this.isLeader = true;
      } else {
        console.log('👥 Ya no eres líder');
        this.isLeader = false;
      }
      
      // Update all UI elements
      this.updateLeaderDisplay();
      this.updateUptoDisplay(); // Enable/disable upTo buttons based on leadership
      this.updateMapaDisplay(); // Update mapa button state (though it should stay disabled after game start)
      this.updateOwaspDisplay(); // Enable/disable OWASP button based on leadership
      this.updatePlayersList(); // Show/hide "Make Leader" buttons
      
      console.log(`Liderazgo actualizado: isLeader=${this.isLeader}, leaderName=${this.leaderName}`);
    }

    sendGameVariableUpdate(type: string, value: any) {
      if (this.isCreator) {
        // Creator broadcasts to all connected players
        this.broadcastToAll({
          type: 'game_variable',
          variable: type,
          value: value
        });
      } else {
        // Player sends to creator
        const dataChannel = this.dataChannels.get('player_connection');
        if (dataChannel && dataChannel.readyState === 'open') {
          const message = {
            type: 'game_variable',
            variable: type,
            value: value
          };
          dataChannel.send(JSON.stringify(message));
        }
      }
    }

    setMapa() {
      if (this.isLeader) {
        // Generate a UUID
        const uuid = this.generateUUID();
        this.mapaValue = uuid;
        this.updateMapaDisplay();
        this.sendGameVariableUpdate('mapa', this.mapaValue);
        
        // Update start game button state
        this.updateStartGameButtonState();
      }
    }

    generateUUID(): string {
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        const r = Math.random() * 16 | 0;
        const v = c === 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
      });
    }

    updateMapaDisplay() {
      if (this.mapaValueElement) {
        this.mapaValueElement.textContent = this.mapaValue || 'Sin asignar';
      }
      

    }

    setOwasp() {
      // Solo el líder puede modificar OWASP, y solo DESPUÉS de iniciar la partida
      if (!this.gameStarted) {
        console.log(`❌ No se puede modificar OWASP antes de iniciar la partida`);
        return;
      }
      
      if (!this.isLeader) {
        console.log(`❌ Solo el líder puede modificar OWASP: isLeader=${this.isLeader}`);
        return;
      }

      const newOwaspValue = prompt('Ingresa el nuevo valor OWASP:');
      if (newOwaspValue !== null && newOwaspValue.trim() !== '') {
        console.log(`📝 Líder estableciendo OWASP: "${this.owaspValue}" → "${newOwaspValue.trim()}"`);
        this.owaspValue = newOwaspValue.trim();
        this.updateOwaspDisplay();
        this.sendGameVariableUpdate('owasp', this.owaspValue);
      } else if (newOwaspValue === '') {
        // Allow clearing the OWASP value
        console.log(`🗑️ Líder limpiando OWASP`);
        this.owaspValue = '';
        this.updateOwaspDisplay();
        this.sendGameVariableUpdate('owasp', this.owaspValue);
      }
    }

    updateOwaspDisplay() {
      if (this.owaspValueElement) {
        this.owaspValueElement.textContent = this.owaspValue || 'Vacío';
      }
      
      // Update button state - only leader can modify after game starts
      if (this.setOwaspBtn) {
        this.setOwaspBtn.disabled = !this.isLeader || !this.gameStarted;
        console.log(`🔧 OWASP button state: disabled=${this.setOwaspBtn.disabled} (isLeader=${this.isLeader}, gameStarted=${this.gameStarted})`);
      }
    }

    cleanup(): void {
      console.log('Cleaning up WebRTC resources...');
      
      // Close all data channels gracefully
      if (this.dataChannels) {
        this.dataChannels.forEach((channel, peerId) => {
          if (channel && channel.readyState !== 'closed') {
            try {
              console.log(`Closing data channel for peer: ${peerId}`);
              channel.close();
            } catch (error) {
              console.warn(`Error closing data channel for peer ${peerId}:`, error);
            }
          }
        });
        this.dataChannels.clear();
      }
      
      // Close all peer connections gracefully
      if (this.peerConnections) {
        this.peerConnections.forEach((connection, peerId) => {
          if (connection && connection.connectionState !== 'closed') {
            try {
              console.log(`Closing peer connection for peer: ${peerId}`);
              connection.close();
            } catch (error) {
              console.warn(`Error closing peer connection for peer ${peerId}:`, error);
            }
          }
        });
        this.peerConnections.clear();
      }
      
      // Reset state
      this.isInitialized = false;
      this.isCreator = false;
      this.gameCode = null;
      this.currentPeerId = null;
      this.messagesSent = 0;
      this.messagesReceived = 0;
      this.iceCandidates = new Map();
      this.iceGatheringComplete = new Map();
      this.pendingOffers = new Map();
      this.playerName = '';
      this.players.clear();
      this.registeredPlayers.clear();
      this.allPlayersNames = [];
      this.receivedPeerId = '';
      this.leaderName = '';
      this.uptoValue = 5;
      this.isLeader = false;
      this.gameStarted = false;
      this.mapaValue = '';
      this.owaspValue = '';
      
      // Reset UI
      this.updateStatus('disconnected', 'Desconectado');
      this.hidePasteInstruction();
      
      console.log('Cleanup completed');
    }
  }

  // Initialize the game when the page loads
  document.addEventListener('DOMContentLoaded', () => {
    const game = new WebRTCGame();
    
    // Clean up resources when page is unloaded
    window.addEventListener('beforeunload', () => {
      game.cleanup();
    });
  });
</script>
