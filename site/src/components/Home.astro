---
import { Image } from 'astro:assets';
import gameLogo from '../assets/images/game-logo.png';
import { getTranslationKey, type Language } from '../utils/i18n';

export interface Props {
  translations: any;
  lang: Language;
}

const { translations, lang } = Astro.props;
---

<section id="home" class="min-h-screen flex items-center justify-center text-center px-4 sm:px-6 lg:px-8">
    <div class="relative z-10 max-w-4xl mx-auto">
        <Image src={gameLogo} alt="Logo de OWASP Top 10 The Game" class="mx-auto mb-6 w-32 sm:w-40 md:w-48 lg:w-64" />
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-6xl font-black uppercase leading-tight" style="color: var(--color-primary);" set:html={getTranslationKey(translations, 'home.title')}></h2>
        <p class="text-base sm:text-lg md:text-xl mt-4 max-w-4xl mx-auto leading-relaxed" set:html={getTranslationKey(translations, 'home.subtitle')}></p>
        <p class="text-base sm:text-lg md:text-xl mt-2 max-w-4xl mx-auto leading-relaxed" set:html={getTranslationKey(translations, 'home.subtitle2')}></p>
        <div class="mt-6 sm:mt-8">
            <a href="https://raw.githubusercontent.com/AgentsWorkingTogether/OWASPTop10TheGame/main/game/cards.pdf" class="btn-primary py-2 px-4 sm:py-3 sm:px-6 md:py-3 md:px-8 rounded-md text-base sm:text-lg inline-block" target="_blank" rel="noopener noreferrer" set:html={getTranslationKey(translations, 'home.button')}></a>
        </div>
    </div>
</section> 